@inject qcSolicitudDesviacion.Auth.AuthMode AuthMode
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="@SupportedCultures.Current.Code">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* PathBase-aware: la app puede correr como sub-aplicación de IIS *@
    <base href="@BaseHref" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    @* Montserrat auto-hospedada + design system MEAX One (mo-*). El orden
       importa: van después de app.css para que sus variables/estilos
       tengan prioridad donde ambos definan lo mismo. *@
    <link rel="stylesheet" href="css/meaxone-fonts.css" />
    <link rel="stylesheet" href="css/meaxone-template.css" />
    <link rel="stylesheet" href="css/meaxone-app.css" />
    <link rel="stylesheet" href="qcSolicitudDesviacion.styles.css" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <HeadOutlet />
</head>

<body class="mo-body">
    <Routes />
    @* Diccionario del idioma actual para los textos de JS (moT); mo-language.js va antes que los scripts que lo usan. *@
    <script type="application/json" id="mo-i18n">@((MarkupString)Loc.ClientJson())</script>
    <script src="js/mo-language.js"></script>
    <script src="lib/html2canvas/html2canvas.min.js"></script>
    <script>
        window.html2canvas || document.write('<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"><\/script>');
    </script>
    <script src="js/qcDesvShare.js"></script>
    <script src="js/meaxone-app.js"></script>
    <script src="js/meaxone-table.js?v=2"></script>
    <script src="lib/chart.js/chart.umd.min.js"></script>
    <script>
        window.Chart || document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"><\/script>');
    </script>
    <script src="js/qcDesvCharts.js"></script>
    <script src="_framework/blazor.web.js"></script>

    @if (!AuthMode.DevLoginActivo && !string.IsNullOrWhiteSpace(HubBaseUrl))
    {
        @* Heartbeat: mantiene viva la cookie .MEAX.JWT del hub (8 h). Silencioso si el hub no responde. *@
        <script>
            (function () {
                var heartbeatUrl = '@HubBaseUrl/auth/heartbeat';

                function latido() {
                    try {
                        fetch(heartbeatUrl, { method: 'POST', credentials: 'include' })
                            .catch(function () { /* hub no disponible: ignorar */ });
                    } catch (e) { /* ignorar */ }
                }

                latido();
                setInterval(latido, 12 * 60 * 1000);
            })();
        </script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private string BaseHref => (HttpContext?.Request.PathBase.Value ?? string.Empty) + "/";

    private string? HubBaseUrl => Configuration["Hub:BaseUrl"]?.TrimEnd('/');
}
