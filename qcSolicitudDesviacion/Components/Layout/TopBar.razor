@inject UsuarioActualService UsuarioActualService

<header class="top-bar">
    <div class="top-bar-inner">
        <div class="top-bar-title">
            <span class="top-bar-title-main">Solicitud de Desviación</span>
            <span class="top-bar-title-sub">Quality Deviation Request</span>
        </div>

        <div class="top-bar-user">
            <div class="top-bar-user-info">
                <div class="top-bar-user-label">Sesión activa / Active Session</div>
                <div class="top-bar-user-name">@nombreUsuario</div>
            </div>

            @* Enlace (no @onclick): el TopBar vive en el layout estático, donde
               los eventos de Blazor no disparan; el href relativo resuelve el
               PathBase vía <base href>. *@
            <a class="top-bar-logout-btn" href="Account/Logout">
                Salir / Logout
            </a>
        </div>
    </div>
</header>

@code {
    private string nombreUsuario = "Usuario";

    protected override async Task OnInitializedAsync()
    {
        var usuario = await UsuarioActualService.ObtenerUsuarioAsync();

        if (usuario is not null)
        {
            nombreUsuario = usuario.NombreCompleto;
        }
    }
}
