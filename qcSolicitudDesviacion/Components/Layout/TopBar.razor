@inject UsuarioActualService UsuarioActualService
@inject IConfiguration Configuration

<nav id="mo-navbar">
    <div id="mo-stripe"></div>

    <button id="mo-hamburger" onclick="moToggleSidebar()" aria-label="Menú">
        <span></span><span></span><span></span>
    </button>

    <a id="mo-logo" href="">
        <img id="mo-logo-img" src="logo-mitsubishi.png" alt="" />
        <div>
            <div id="mo-logo-text">Solicitud de Desviación</div>
            <div id="mo-logo-sub">Quality Deviation Request</div>
        </div>
    </a>

    <div class="mo-spacer"></div>

    <div id="mo-user-wrap">
        <button id="mo-user-btn" type="button" onclick="moToggleUserMenu(event)">
            <div id="mo-user-avatar">@Iniciales</div>
            <span id="mo-user-name">@nombreUsuario</span>
            <svg id="mo-user-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
            </svg>
        </button>

        <div id="mo-user-dropdown">
            <div id="mo-user-dropdown-header">
                <div class="mo-dd-avatar">@Iniciales</div>
                <div>
                    <div class="mo-dd-name">@nombreUsuario</div>
                    <div class="mo-dd-login">Sesión activa / Active session</div>
                </div>
            </div>
            <div class="mo-dd-divider"></div>

            @if (!string.IsNullOrWhiteSpace(HubBaseUrl))
            {
                <a class="mo-dd-item" href="@HubBaseUrl">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    <span>Volver al Hub / Back to Hub</span>
                </a>
                <div class="mo-dd-divider"></div>
            }

            @* Enlace (no @onclick): el TopBar vive en el layout estático, donde
               los eventos de Blazor no disparan; el href relativo resuelve el
               PathBase vía <base href>. *@
            <a class="mo-dd-item mo-dd-logout" href="Account/Logout">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m16 17 5-5-5-5"/><path d="M21 12H9"/><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                </svg>
                <span>Salir / Logout</span>
            </a>
        </div>
    </div>
</nav>

@code {
    private string nombreUsuario = "Usuario";

    private string? HubBaseUrl => Configuration["Hub:BaseUrl"]?.TrimEnd('/');

    private string Iniciales =>
        string.Concat(
            nombreUsuario
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Take(2)
                .Select(p => char.ToUpperInvariant(p[0])));

    protected override async Task OnInitializedAsync()
    {
        var usuario = await UsuarioActualService.ObtenerUsuarioAsync();

        if (usuario is not null)
        {
            nombreUsuario = usuario.NombreCompleto;
        }
    }
}
