@page "/"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService

<PageTitle>@L["Home - Deviation Request"]</PageTitle>

<div class="index-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">@L["Deviation System"]</div>

            <div id="mo-banner-title">@L["Deviation Request"]</div>

            <div id="mo-banner-sub">
                @L["Manage deviation requests, approvals, extensions and closure from a single place."]
            </div>

            <div class="hero-meta">
                <span class="meta-chip">@L["Requests"]</span>
                <span class="meta-chip">@L["Approvals"]</span>
                <span class="meta-chip">@L["Extensions"]</span>
                <span class="meta-chip">@L["Closure"]</span>
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-primary" href="solicitudes/crear">
                @L["New Deviation"]
            </a>

            <a class="mo-btn mo-btn-secondary-outline" href="desviaciones">
                @L["View Deviations"]
            </a>
        </div>
    </section>

    @if (cargando)
    {
        <div class="index-loading">
            <div class="index-skeleton skeleton-card"></div>
            <div class="index-skeleton skeleton-card"></div>
            <div class="index-skeleton skeleton-card"></div>
            <div class="index-skeleton skeleton-card"></div>
        </div>
    }
    else
    {
        <section class="stats-grid">
            <a class="stat-card" href="desviaciones">
                <span>@L["Total Requests"]</span>
                <strong>@totalSolicitudes</strong>
                <p>@L["Requests registered in the system."]</p>
            </a>

            <a class="stat-card stat-vigente" href="desviaciones">
                <span>@L["Active Requests"]</span>
                <strong>@solicitudesVigentes</strong>
                <p>@L["Open requests within their validity date."]</p>
            </a>

            <a class="stat-card stat-vencida" href="desviaciones">
                <span>@L["Expired Requests"]</span>
                <strong>@solicitudesVencidas</strong>
                <p>@L["Open requests past their validity date."]</p>
            </a>

            <a class="stat-card stat-cerrada" href="desviaciones">
                <span>@L["Closed Requests"]</span>
                <strong>@solicitudesCerradas</strong>
                <p>@L["Closed deviations with control data."]</p>
            </a>
        </section>

        <section class="panel-card recent-panel">
            <div class="panel-head">
                <div>
                    <h2>@L["Recent Requests"]</h2>
                    <p class="panel-subtitle">@L["Latest registered deviations."]</p>
                </div>

                <a class="panel-link" href="desviaciones">
                    @L["View all"]
                </a>
            </div>

            @if (!solicitudesRecientes.Any())
            {
                <div class="empty-state compact">
                    @L["No registered requests."]
                </div>
            }
            else
            {
                <div class="recent-list">
                    @foreach (var item in solicitudesRecientes)
                    {
                        <a class="recent-item" href="solicitudes/@item.SolicitudId">
                            <div>
                                <strong>#@item.SolicitudId - @item.NumeroParteAfectado</strong>
                                <span>@item.NombreSolicitante | @item.Clientes</span>
                            </div>

                            <div class="recent-meta">
                                <span class="mo-badge @QcDesvEstadoBadge.ClaseSolicitud(item.EstadoSolicitudCodigo)">
                                    <span class="mo-badge-dot"></span>@CatalogoTexto.Nombre(item.EstadoSolicitudEs, item.EstadoSolicitudEn)
                                </span>
                                <small>@L["Validity: {0}", item.FechaVigencia.ToString("yyyy-MM-dd")]</small>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private bool cargando = true;

    private int totalSolicitudes;
    private int solicitudesVigentes;
    private int solicitudesVencidas;
    private int solicitudesCerradas;

    private List<QcDesvSolicitudResumen> solicitudesRecientes = new();

    protected override async Task OnInitializedAsync()
    {
        var solicitudes = await SolicitudService.ObtenerResumenAsync();

        var hoy = DateTime.Today;

        totalSolicitudes = solicitudes.Count;

        solicitudesCerradas = solicitudes.Count(x =>
            x.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cerrada);

        solicitudesVigentes = solicitudes.Count(x =>
            EsSolicitudAbierta(x) &&
            x.FechaVigencia.Date >= hoy);

        solicitudesVencidas = solicitudes.Count(x =>
            EsSolicitudAbierta(x) &&
            x.FechaVigencia.Date < hoy);

        solicitudesRecientes = solicitudes
            .OrderByDescending(x => x.SolicitudId)
            .Take(8)
            .ToList();

        cargando = false;
    }

    private static bool EsSolicitudAbierta(QcDesvSolicitudResumen solicitud)
    {
        return solicitud.EstadoSolicitudCodigo != QcDesvCodigos.EstadoSolicitud.Cerrada &&
               solicitud.EstadoSolicitudCodigo != QcDesvCodigos.EstadoSolicitud.Cancelada &&
               solicitud.EstadoSolicitudCodigo != QcDesvCodigos.EstadoSolicitud.Rechazada;
    }
}