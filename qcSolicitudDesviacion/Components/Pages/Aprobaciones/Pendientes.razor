@page "/aprobaciones/pendientes"
@rendermode InteractiveServer

@inject AprobacionService AprobacionService
@inject UsuarioActualService UsuarioActualService

<PageTitle>Aprobaciones pendientes</PageTitle>

<div class="nueva-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">Workflow / Approval Flow</div>
            <div id="mo-banner-title">Aprobaciones pendientes / Pending Approvals</div>
            <div id="mo-banner-sub">
                Solicitudes que requieren revisión de acuerdo con tus roles asignados.
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-secondary-outline" href="desviaciones">Desviaciones / Deviations</a>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-head">
            <div>
                <h2>Mis pendientes / My pending approvals</h2>
                <p class="panel-subtitle">Usuario: ID @usuarioActualId</p>
            </div>
            <span class="mo-badge mo-badge-primary">@pendientes.Count pendientes</span>
        </div>

        @if (cargando)
        {
            <div class="nueva-skeleton nueva-skeleton-table"></div>
        }
        else if (!pendientes.Any())
        {
            <div class="empty-state compact">
                <div class="empty-title">Sin pendientes / No pending approvals</div>
                <p class="empty-text">No tienes aprobaciones pendientes en este momento.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="mo-table procesos-table">
                    <thead>
                        <tr>
                            <th>Solicitud / Request</th>
                            <th>Parte / Part</th>
                            <th>Paso / Step</th>
                            <th>Tipo flujo / Flow</th>
                            <th>Fecha asignación / Assigned Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pendientes)
                        {
                            <tr>
                                <td>
                                    <div class="cell-title">#@item.SolicitudId</div>
                                    <div class="cell-subtitle">@item.Solicitud?.NombreSolicitante</div>
                                </td>
                                <td>
                                    <div class="cell-title">@item.Solicitud?.NumeroParteAfectado</div>
                                    <div class="cell-subtitle">@item.Solicitud?.Clientes</div>
                                </td>
                                <td>
                                    <span class="mo-badge mo-badge-primary">@item.RolAprobador?.NombreEs</span>
                                </td>
                                <td>
                                    <span class="mo-badge mo-badge-secondary">@item.TipoFlujoCodigo</span>
                                </td>
                                <td>@item.FechaAsignacion.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a class="mo-btn mo-btn-primary mo-btn-sm" href="aprobaciones/revisar/@item.Id">
                                        Revisar / Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private bool cargando = true;
    private List<QcDesvAprobacion> pendientes = new();
    private int usuarioActualId;

    protected override async Task OnInitializedAsync()
    {
        usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();

        pendientes = await AprobacionService.ObtenerPendientesPorUsuarioAsync(
            usuarioActualId);

        cargando = false;
    }
}