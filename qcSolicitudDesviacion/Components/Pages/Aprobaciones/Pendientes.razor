@page "/aprobaciones/pendientes"
@rendermode InteractiveServer

@inject AprobacionService AprobacionService
@inject UsuarioActualService UsuarioActualService

<PageTitle>@L["Pending approvals"]</PageTitle>

<div class="nueva-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">@L["Approval flow"]</div>
            <div id="mo-banner-title">@L["Pending approvals"]</div>
            <div id="mo-banner-sub">
                @L["Requests that require review according to your assigned roles."]
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-secondary-outline" href="desviaciones">@L["Deviations"]</a>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-head">
            <div>
                <h2>@L["My pending approvals"]</h2>
                <p class="panel-subtitle">@L["User: ID {0}", usuarioActualId]</p>
            </div>
            <span class="mo-badge mo-badge-primary">@L["{0} pending", PendientesFiltrados.Count()]</span>
        </div>

        @if (!cargando && pendientes.Any())
        {
            <div class="pend-filters">
                <div class="field-with-help">
                    <label class="mo-form-label">@L["Department"]</label>
                    <select class="mo-form-select" @bind="departamentoFiltro">
                        <option value="">@L["All"]</option>
                        @foreach (var depto in DepartamentosDisponibles)
                        {
                            <option value="@depto">@depto</option>
                        }
                    </select>
                </div>
            </div>
        }

        @if (cargando)
        {
            <div class="nueva-skeleton nueva-skeleton-table"></div>
        }
        else if (!pendientes.Any())
        {
            <div class="empty-state compact">
                <div class="empty-title">@L["No pending approvals"]</div>
                <p class="empty-text">@L["You do not have pending approvals right now."]</p>
            </div>
        }
        else if (!PendientesFiltrados.Any())
        {
            <div class="empty-state compact">
                @L["There are no pending approvals for the selected department."]
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="mo-table procesos-table">
                    <thead>
                        <tr>
                            <th>@L["Request"]</th>
                            <th>@L["Part"]</th>
                            <th>@L["Department"]</th>
                            <th>@L["Step"]</th>
                            <th>@L["Flow type"]</th>
                            <th>@L["Assigned date"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PendientesFiltrados)
                        {
                            <tr>
                                <td>
                                    <div class="cell-title">#@item.SolicitudId</div>
                                    <div class="cell-subtitle">@item.Solicitud?.NombreSolicitante</div>
                                </td>
                                <td>
                                    <div class="cell-title">@item.Solicitud?.NumeroParteAfectado</div>
                                    <div class="cell-subtitle">@item.Solicitud?.Clientes</div>
                                </td>
                                <td>@item.Solicitud?.DepartamentoSolicitante</td>
                                <td>
                                    <span class="mo-badge mo-badge-primary">@CatalogoTexto.Nombre(item.RolAprobador?.NombreEs, item.RolAprobador?.NombreEn)</span>
                                </td>
                                <td>
                                    <span class="mo-badge mo-badge-secondary">@item.TipoFlujoCodigo</span>
                                </td>
                                <td>@item.FechaAsignacion.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a class="mo-btn mo-btn-primary mo-btn-sm" href="aprobaciones/revisar/@item.Id">
                                        @L["Review"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private bool cargando = true;
    private List<QcDesvAprobacion> pendientes = new();
    private int usuarioActualId;
    private string departamentoFiltro = string.Empty;

    private IEnumerable<QcDesvAprobacion> PendientesFiltrados =>
        string.IsNullOrWhiteSpace(departamentoFiltro)
            ? pendientes
            : pendientes.Where(p => string.Equals(
                p.Solicitud?.DepartamentoSolicitante,
                departamentoFiltro,
                StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> DepartamentosDisponibles =>
        pendientes
            .Select(p => p.Solicitud?.DepartamentoSolicitante)
            .Where(d => !string.IsNullOrWhiteSpace(d))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(d => d)!;

    protected override async Task OnInitializedAsync()
    {
        usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();

        pendientes = await AprobacionService.ObtenerPendientesPorUsuarioAsync(
            usuarioActualId);

        cargando = false;
    }
}