@page "/solicitudes/{SolicitudId:int}/cerrar"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService
@inject CierreDesviacionService CierreService
@inject UsuarioActualService UsuarioActualService
@inject NavigationManager Navigation

<PageTitle>@L["Close deviation"]</PageTitle>

<div class="nueva-page">
    @if (cargando)
    {
        <div class="nueva-skeleton nueva-skeleton-form"></div>
    }
    else if (solicitud is null)
    {
        <section class="panel-card">
            <div class="empty-state compact">@L["Request not found."]</div>
        </section>
    }
    else
    {
        <section id="mo-banner">
            <div class="mo-banner-orb mo-banner-orb-1"></div>
            <div class="mo-banner-orb mo-banner-orb-2"></div>

            <div id="mo-banner-content">
                <div id="mo-banner-tag">@L["Closure"]</div>
                <div id="mo-banner-title">@L["Close deviation #{0}", solicitud.Id]</div>
                <div id="mo-banner-sub">
                    @L["Enter the control data to close the deviation."]
                </div>
            </div>

            <div class="hero-actions">
                <a class="mo-btn mo-btn-secondary-outline" href="solicitudes/@solicitud.Id">@L["Back"]</a>
            </div>
        </section>

        <div class="nueva-grid">
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>@L["Control"]</h2>
                        <p class="panel-subtitle">@L["Data required for closure."]</p>
                    </div>
                </div>

                <EditForm Model="@model" OnValidSubmit="@GuardarAsync">
                    <div class="stack-fields">
                        <div>
                            <label class="mo-form-label">@L["Start Lot Number"]</label>
                            <InputText class="mo-form-control" @bind-Value="model.NumeroLoteInicio" />
                        </div>

                        <div>
                            <label class="mo-form-label">@L["Start Case Number"]</label>
                            <InputText class="mo-form-control" @bind-Value="model.NumeroCaseInicio" />
                        </div>

                        <div>
                            <label class="mo-form-label">@L["Final Lot Number"]</label>
                            <InputText class="mo-form-control" @bind-Value="model.NumeroLoteFinal" />
                        </div>

                        <div>
                            <label class="mo-form-label">@L["Final Case Number"]</label>
                            <InputText class="mo-form-control" @bind-Value="model.NumeroCaseFinal" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(mensaje))
                        {
                            <div class="mo-alert mo-alert-danger">@mensaje</div>
                        }

                        <button class="mo-btn mo-btn-primary" type="submit" disabled="@guardando">
                            @(guardando ? L["Closing..."] : L["Close deviation"])
                        </button>
                    </div>
                </EditForm>
            </section>

            <aside class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>@L["Summary"]</h2>
                    </div>
                </div>

                <div class="summary-grid">
                    <div class="summary-item">
                        <span>@L["Part"]</span>
                        <strong>@solicitud.NumeroParteAfectado</strong>
                    </div>

                    <div class="summary-item">
                        <span>@L["Requester"]</span>
                        <strong>@solicitud.NombreSolicitante</strong>
                    </div>

                    <div class="summary-item">
                        <span>@L["Status"]</span>
                        <strong>@CatalogoTexto.Nombre(solicitud.EstadoSolicitud?.NombreEs, solicitud.EstadoSolicitud?.NombreEn)</strong>
                    </div>

                    <div class="summary-item">
                        <span>@L["Validity"]</span>
                        <strong>@solicitud.FechaVigencia.ToString("yyyy-MM-dd")</strong>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    private QcDesvSolicitud? solicitud;
    private QcDesvCierreFormModel model = new();

    private bool cargando = true;
    private bool guardando;
    private string mensaje = string.Empty;
    private int usuarioActualId;

    protected override async Task OnInitializedAsync()
    {
        usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();
        solicitud = await SolicitudService.ObtenerDetalleAsync(SolicitudId);

        if (solicitud is not null)
        {
            model.SolicitudId = solicitud.Id;
        }

        cargando = false;
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        mensaje = string.Empty;

        var resultado = await CierreService.CerrarAsync(
            model,
            usuarioActualId);

        if (resultado.Succeeded)
        {
            Navigation.NavigateTo($"solicitudes/{SolicitudId}");
            return;
        }

        mensaje = resultado.Message;
        guardando = false;
    }
}