@page "/solicitudes/{SolicitudId:int}/cancelar"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService
@inject UsuarioActualService UsuarioActualService
@inject NavigationManager Navigation

<PageTitle>Cancelar solicitud</PageTitle>

<div class="nueva-page">
    @if (cargando)
    {
        <div class="nueva-skeleton nueva-skeleton-form"></div>
    }
    else if (solicitud is null)
    {
        <section class="panel-card">
            <div class="empty-state compact">Solicitud no encontrada.</div>
        </section>
    }
    else
    {
        <section id="mo-banner">
            <div class="mo-banner-orb mo-banner-orb-1"></div>
            <div class="mo-banner-orb mo-banner-orb-2"></div>

            <div id="mo-banner-content">
                <div id="mo-banner-tag">Cancelar / Cancel</div>
                <div id="mo-banner-title">Cancelar solicitud #@solicitud.Id</div>
                <div id="mo-banner-sub">
                    Esta acción marcará la solicitud como cancelada.
                </div>
            </div>

            <div class="hero-actions">
                <a class="mo-btn mo-btn-secondary-outline" href="solicitudes/@solicitud.Id">Volver / Back</a>
            </div>
        </section>

        <div class="nueva-grid">
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Comentario de cancelación / Cancellation Comment</h2>
                        <p class="panel-subtitle">Capture la razón por la que desea cancelar la solicitud.</p>
                    </div>
                </div>

                <div class="stack-fields">
                    <div>
                        <label class="mo-form-label">Comentario / Comment</label>
                        <textarea class="mo-form-control" rows="5" @bind="comentario"></textarea>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensaje))
                    {
                        <div class="mo-alert mo-alert-danger">@mensaje</div>
                    }

                    <button class="mo-btn mo-btn-danger" disabled="@procesando" @onclick="CancelarAsync">
                        @(procesando ? "Cancelando..." : "Cancelar solicitud / Cancel request")
                    </button>
                </div>
            </section>

            <aside class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Resumen / Summary</h2>
                    </div>
                </div>

                <div class="summary-grid">
                    <div class="summary-item">
                        <span>Parte / Part</span>
                        <strong>@solicitud.NumeroParteAfectado</strong>
                    </div>

                    <div class="summary-item">
                        <span>Solicitante / Requester</span>
                        <strong>@solicitud.NombreSolicitante</strong>
                    </div>

                    <div class="summary-item">
                        <span>Estado / Status</span>
                        <strong>@solicitud.EstadoSolicitud?.NombreEs</strong>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    private QcDesvSolicitud? solicitud;
    private bool cargando = true;
    private bool procesando;
    private string comentario = string.Empty;
    private string mensaje = string.Empty;
    private int usuarioActualId;

    protected override async Task OnInitializedAsync()
    {
        usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();
        solicitud = await SolicitudService.ObtenerDetalleAsync(SolicitudId);
        cargando = false;
    }

    private async Task CancelarAsync()
    {
        procesando = true;
        mensaje = string.Empty;

        var resultado = await SolicitudService.CancelarAsync(
            SolicitudId,
            usuarioActualId,
            comentario);

        if (resultado.Succeeded)
        {
            Navigation.NavigateTo($"solicitudes/{SolicitudId}");
            return;
        }

        mensaje = resultado.Message;
        procesando = false;
    }
}