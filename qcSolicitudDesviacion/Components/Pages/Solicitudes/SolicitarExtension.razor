@page "/solicitudes/{SolicitudId:int}/extension"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService
@inject ExtensionService ExtensionService
@inject UsuarioActualService UsuarioActualService
@inject AdminAprobadoresService AdminAprobadoresService
@inject NavigationManager Navigation

<PageTitle>@L["Request extension"]</PageTitle>

<div class="nueva-page">
    @if (cargando)
    {
        <div class="nueva-skeleton nueva-skeleton-form"></div>
    }
    else if (solicitud is null)
    {
        <section class="panel-card">
            <div class="empty-state compact">@L["Request not found."]</div>
        </section>
    }
    else
    {
        <section id="mo-banner">
            <div class="mo-banner-orb mo-banner-orb-1"></div>
            <div class="mo-banner-orb mo-banner-orb-2"></div>

            <div id="mo-banner-content">
                <div id="mo-banner-tag">@L["Extension"]</div>
                <div id="mo-banner-title">@L["Request extension for deviation #{0}", solicitud.Id]</div>
                <div id="mo-banner-sub">
                    @L["You can request a maximum of 2 extensions and the validity cannot exceed 6 months from creation."]
                </div>
            </div>

            <div class="hero-actions">
                <a class="mo-btn mo-btn-secondary-outline" href="solicitudes/@solicitud.Id">@L["Back"]</a>
            </div>
        </section>

        <div class="nueva-grid">
            <div class="main-stack">
                <EditForm Model="@model" OnValidSubmit="@GuardarAsync">
                    <section class="panel-card">
                        <div class="panel-head">
                            <div>
                                <h2>@L["Extension Data"]</h2>
                                <p class="panel-subtitle">@L["Enter the new date and the reason."]</p>
                            </div>
                        </div>

                        <div class="stack-fields">
                            <div>
                                <label class="mo-form-label">@L["New Validity Date"]</label>
                                <InputDate class="mo-form-control" @bind-Value="model.NuevaFechaVigencia" />
                                <div class="field-help">
                                    @L["Maximum allowed date: {0}", FechaMaxima.ToString("yyyy-MM-dd")]
                                </div>
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Extension Reason"]</label>
                                <InputTextArea class="mo-form-control" rows="5" @bind-Value="model.RazonExtension" />
                            </div>
                        </div>
                    </section>

                    <section class="panel-card">
                        <div class="panel-head">
                            <div>
                                <h2>@L["Approvers"]</h2>
                                <p class="panel-subtitle">
                                    @L["Select the user responsible for approving each stage of the extension flow."]
                                </p>
                            </div>
                        </div>

                        <div class="approver-flow-list">
                            <article class="approver-flow-card approver-flow-card-auto">
                                <div class="approver-step">1</div>

                                <div class="approver-info">
                                    <h3>QMS</h3>
                                    <p>QMS</p>

                                    <div class="field-help">
                                        @L["Automatically assigned to system administrators; no approver selection required."]
                                    </div>
                                </div>
                            </article>

                            @if (rolesAprobadores.Count == 0)
                            {
                                <div class="mo-alert mo-alert-danger">
                                    @L["No approvers are configured. First configure users in Administration > Approvers."]
                                </div>
                            }
                            else
                            {
                                @foreach (var rol in rolesAprobadores.OrderBy(x => x.Orden))
                                {
                                    <article class="approver-flow-card">
                                        <div class="approver-step">
                                            @rol.Orden
                                        </div>

                                        <div class="approver-info">
                                            <h3>@CatalogoTexto.Nombre(rol.NombreEs, rol.NombreEn)</h3>

                                            @if (rol.Usuarios.Count == 0)
                                            {
                                                <div class="field-warning">
                                                    @L["There are no active users with this role."]
                                                </div>
                                            }
                                            else
                                            {
                                                <InputSelect TValue="int?"
                                                             class="mo-form-select"
                                                             @bind-Value="rol.UsuarioSeleccionadoId">
                                                    <option value="">@L["Select approver"]</option>

                                                    @foreach (var usuario in rol.Usuarios)
                                                    {
                                                        <option value="@usuario.UsuarioId">
                                                            @usuario.NombreCompleto (@usuario.UserName)
                                                        </option>
                                                    }
                                                </InputSelect>
                                            }
                                        </div>
                                    </article>
                                }
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(mensaje))
                        {
                            <div class="mo-alert mo-alert-danger">@mensaje</div>
                        }

                        <div class="submit-panel-inner">
                            <button class="mo-btn mo-btn-primary" type="submit" disabled="@guardando">
                                @(guardando ? L["Sending..."] : L["Request extension"])
                            </button>
                        </div>
                    </section>
                </EditForm>
            </div>

            <aside class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>@L["Summary"]</h2>
                    </div>
                </div>

                <div class="summary-grid">
                    <div class="summary-item">
                        <span>@L["Current validity"]</span>
                        <strong>@solicitud.FechaVigencia.ToString("yyyy-MM-dd")</strong>
                    </div>

                    <div class="summary-item">
                        <span>@L["Used extensions"]</span>
                        <strong>@L["{0} of {1}", solicitud.NumeroExtensionActual, 2]</strong>
                    </div>

                    <div class="summary-item">
                        <span>@L["Created date"]</span>
                        <strong>@solicitud.FechaCreacion.ToString("yyyy-MM-dd")</strong>
                    </div>

                    <div class="summary-item">
                        <span>@L["Max allowed"]</span>
                        <strong>@FechaMaxima.ToString("yyyy-MM-dd")</strong>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    private QcDesvSolicitud? solicitud;
    private QcDesvExtensionFormModel model = new();
    private List<QcDesvAprobadorRolCrearVm> rolesAprobadores = new();

    private bool cargando = true;
    private bool guardando;
    private string mensaje = string.Empty;
    private int usuarioActualId;

    private DateTime FechaMaxima =>
        solicitud?.FechaCreacion.Date.AddMonths(6) ?? DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();
        solicitud = await SolicitudService.ObtenerDetalleAsync(SolicitudId);
        rolesAprobadores = await AdminAprobadoresService.ObtenerAprobadoresParaExtensionAsync();

        if (solicitud is not null)
        {
            model.SolicitudId = solicitud.Id;
            model.NuevaFechaVigencia = solicitud.FechaVigencia.Date.AddDays(1);

            PrecargarAprobadoresPrevios();
        }

        cargando = false;
    }

    private void PrecargarAprobadoresPrevios()
    {
        if (solicitud is null)
        {
            return;
        }

        var ultimosAprobadoresPorRol = solicitud.Aprobaciones
            .Where(x => x.UsuarioAprobadorId.HasValue && x.UsuarioAprobadorId.Value > 0)
            .GroupBy(x => x.RolAprobadorCodigo)
            .ToDictionary(
                g => g.Key,
                g => g.OrderByDescending(x => x.FechaAsignacion).First().UsuarioAprobadorId!.Value);

        foreach (var rol in rolesAprobadores)
        {
            if (!ultimosAprobadoresPorRol.TryGetValue(rol.RolCodigo, out var usuarioId))
            {
                continue;
            }

            if (rol.Usuarios.Any(u => u.UsuarioId == usuarioId))
            {
                rol.UsuarioSeleccionadoId = usuarioId;
            }
        }
    }

    private void PrepararAprobadoresAntesDeGuardar()
    {
        model.AprobadoresSeleccionados = rolesAprobadores
            .Select(x => new QcDesvAprobadorSeleccionadoFormModel
            {
                RolCodigo = x.RolCodigo,
                UsuarioAprobadorId = x.UsuarioSeleccionadoId
            })
            .ToList();
    }

    private bool ValidarAprobadoresSeleccionados()
    {
        if (rolesAprobadores.Count == 0)
        {
            mensaje = L["No approvers are configured. First configure users in Administration > Approvers."].Value;
            return false;
        }

        var rolesSinUsuarios = rolesAprobadores
            .Where(x => x.Usuarios.Count == 0)
            .Select(x => CatalogoTexto.Nombre(x.NombreEs, x.NombreEn))
            .ToList();

        if (rolesSinUsuarios.Count > 0)
        {
            mensaje = L["There are roles without configured users: {0}.", string.Join(", ", rolesSinUsuarios)].Value;
            return false;
        }

        var rolesFaltantes = rolesAprobadores
            .Where(x => !x.UsuarioSeleccionadoId.HasValue || x.UsuarioSeleccionadoId.Value <= 0)
            .Select(x => CatalogoTexto.Nombre(x.NombreEs, x.NombreEn))
            .ToList();

        if (rolesFaltantes.Count > 0)
        {
            mensaje = L["You must select an approver for: {0}.", string.Join(", ", rolesFaltantes)].Value;
            return false;
        }

        return true;
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        mensaje = string.Empty;

        PrepararAprobadoresAntesDeGuardar();

        if (!ValidarAprobadoresSeleccionados())
        {
            guardando = false;
            return;
        }

        var resultado = await ExtensionService.SolicitarExtensionAsync(
            model,
            usuarioActualId);

        if (resultado.Succeeded)
        {
            Navigation.NavigateTo($"solicitudes/{SolicitudId}");
            return;
        }

        mensaje = resultado.Message;
        guardando = false;
    }
}