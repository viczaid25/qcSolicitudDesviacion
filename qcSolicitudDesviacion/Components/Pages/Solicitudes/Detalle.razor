@page "/solicitudes/{SolicitudId:int}"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService
@inject UsuarioActualService UsuarioActualService

<PageTitle>@L["Deviation detail"]</PageTitle>

<div class="nueva-page">
    @if (cargando)
    {
        <div class="nueva-loading">
            <div class="nueva-skeleton nueva-skeleton-hero"></div>
            <div class="nueva-skeleton nueva-skeleton-form"></div>
        </div>
    }
    else if (solicitud is null)
    {
        <section class="panel-card">
            <div class="empty-state compact">
                <div class="empty-title">@L["Request not found"]</div>
                <p class="empty-text">@L["There is no request with the given ID."]</p>
                <a class="mo-btn mo-btn-primary mt-3" href="desviaciones">@L["Back"]</a>
            </div>
        </section>
    }
    else
    {
        <section id="mo-banner">
            <div class="mo-banner-orb mo-banner-orb-1"></div>
            <div class="mo-banner-orb mo-banner-orb-2"></div>

            <div id="mo-banner-content">
                <div id="mo-banner-tag">@L["Deviation #{0}", solicitud.Id]</div>
                <div id="mo-banner-title">@solicitud.NumeroParteAfectado</div>

                <div class="hero-meta">
                    <span class="meta-chip">@CatalogoTexto.Nombre(solicitud.TipoDesviacion?.NombreEs, solicitud.TipoDesviacion?.NombreEn)</span>
                    <span class="meta-chip">@CatalogoTexto.Nombre(solicitud.EstadoSolicitud?.NombreEs, solicitud.EstadoSolicitud?.NombreEn)</span>
                    <span class="meta-chip">@L["Validity: {0}", FormatDate(solicitud.FechaVigencia)]</span>
                    <span class="meta-chip">@L["Extensions: {0} / {1}", solicitud.NumeroExtensionActual, 2]</span>
                </div>

                <div id="mo-banner-sub">
                    @L["Requester: {0} | Customer(s): {1}", solicitud.NombreSolicitante, solicitud.Clientes]
                </div>
            </div>

            <div class="hero-actions">
                <a class="mo-btn mo-btn-secondary-outline" href="desviaciones">@L["Back"]</a>

                @if (PuedeEditar)
                {
                    <a class="mo-btn mo-btn-secondary-outline" href="solicitudes/@solicitud.Id/editar">
                        @L["Edit"]
                    </a>
                }


                @if (PuedeSolicitarExtension)
                {
                    <a class="mo-btn mo-btn-secondary-outline" href="solicitudes/@solicitud.Id/extension">
                        @L["Extension"]
                    </a>
                }

                @if (PuedeCerrar)
                {
                    <a class="mo-btn mo-btn-primary" href="solicitudes/@solicitud.Id/cerrar">
                        @L["Close"]
                    </a>
                }
            </div>
        </section>

        <div class="detail-workspace">
            <main class="main-stack">
                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["General information"]</h2>
                            <p class="panel-subtitle">@L["Complete data of the deviation request."]</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@L["Request #{0}", solicitud.Id]</span>
                    </div>

                    <div class="info-grid">
                        <div class="summary-item">
                            <span>@L["Deviation ID"]</span>
                            <strong>#@solicitud.Id</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Request Date"]</span>
                            <strong>@FormatDate(solicitud.FechaSolicitud)</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Requester"]</span>
                            <strong>@solicitud.NombreSolicitante</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Department"]</span>
                            <strong>@solicitud.DepartamentoSolicitante</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Affected Business Unit"]</span>
                            <strong>@solicitud.UnidadNegocioAfectada</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Line Code"]</span>
                            <strong>@solicitud.CodigoLinea</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Customer(s)"]</span>
                            <strong>@solicitud.Clientes</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Deviation Type"]</span>
                            <strong>@CatalogoTexto.Nombre(solicitud.TipoDesviacion?.NombreEs, solicitud.TipoDesviacion?.NombreEn)</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Status"]</span>
                            <strong>@CatalogoTexto.Nombre(solicitud.EstadoSolicitud?.NombreEs, solicitud.EstadoSolicitud?.NombreEn)</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Validity Period"]</span>
                            <strong>@FormatDate(solicitud.FechaVigencia)</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Quantity of Pieces"]</span>
                            <strong>@solicitud.CantidadPiezas</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Affected Part Number"]</span>
                            <strong>@solicitud.NumeroParteAfectado</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Process Requirement"]</span>
                            <strong>@CatalogoTexto.Nombre(solicitud.RequisitoProceso?.NombreEs, solicitud.RequisitoProceso?.NombreEn)</strong>
                        </div>

                        @if (solicitud.RequisitoProcesoCodigo == QcDesvCodigos.RequisitoProceso.Otro)
                        {
                            <div class="summary-item">
                                <span>@L["Other Requirement"]</span>
                                <strong>@Texto(solicitud.RequisitoProcesoOtro)</strong>
                            </div>
                        }

                        <div class="summary-item">
                            <span>@L["Used extensions"]</span>
                            <strong>@L["{0} of {1}", solicitud.NumeroExtensionActual, 2]</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Created date"]</span>
                            <strong>@FormatDateTime(solicitud.FechaCreacion)</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Last Modified"]</span>
                            <strong>@FormatDateTime(solicitud.FechaModificacion)</strong>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <div class="info-grid csr-grid">
                        <div class="summary-item">
                            <span>CSR 1</span>
                            <strong>@Texto(solicitud.CSR1)</strong>
                        </div>

                        <div class="summary-item">
                            <span>CSR 2</span>
                            <strong>@Texto(solicitud.CSR2)</strong>
                        </div>

                        <div class="summary-item">
                            <span>CSR 3</span>
                            <strong>@Texto(solicitud.CSR3)</strong>
                        </div>

                        <div class="summary-item">
                            <span>@L["Inform Customer"]</span>
                            <strong>@SiNo(solicitud.InformarCliente)</strong>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <div class="detail-box">
                        <span>@L["Reason"]</span>
                        <p>@Texto(solicitud.RazonInformarCliente)</p>
                    </div>
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Deviation Description"]</h2>
                            <p class="panel-subtitle">@L["Comparison between the current process and the process with the temporary change."]</p>
                        </div>
                    </div>

                    @if (solicitud.Descripcion is not null)
                    {
                        <div class="detail-stack">
                            <div class="detail-box">
                                <span>@L["How is the process performed under normal operating conditions?"]</span>
                                <p>@Texto(solicitud.Descripcion.ComoDebeRealizarseProceso)</p>
                            </div>

                            <div class="detail-box">
                                <span>@L["What controls are followed under normal operating conditions?"]</span>
                                <p>@Texto(solicitud.Descripcion.ControlesOperacionActual)</p>
                            </div>

                            <div class="detail-box">
                                <span>@L["What is the temporary change that will be implemented?"]</span>
                                <p>@Texto(solicitud.Descripcion.ProcesoDespuesCambioTemporal)</p>
                            </div>

                            <div class="detail-box">
                                <span>@L["Will additional controls be implemented during the temporary change to mitigate risks? If so, describe them."]</span>
                                <p>@Texto(solicitud.Descripcion.ControlesDuranteCambio)</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state compact">@L["No description recorded."]</div>
                    }
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Risk Analysis"]</h2>
                            <p class="panel-subtitle">@L["Applies only to critical deviations."]</p>
                        </div>

                        @if (solicitud.AnalisisRiesgo is not null)
                        {
                            <span class="mo-badge mo-badge-danger">@L["Critical"]</span>
                        }
                        else
                        {
                            <span class="mo-badge mo-badge-secondary">@L["Not applicable"]</span>
                        }
                    </div>

                    @if (solicitud.AnalisisRiesgo is not null)
                    {
                        <div class="risk-comparison">
                            <div class="risk-block">
                                <h3>@L["Current Operation"]</h3>

                                <div class="summary-grid three">
                                    <div class="summary-item">
                                        <span>@L["Severity"]</span>
                                        <strong>@solicitud.AnalisisRiesgo.SeveridadActual</strong>
                                    </div>

                                    <div class="summary-item">
                                        <span>@L["Occurrence"]</span>
                                        <strong>@solicitud.AnalisisRiesgo.OcurrenciaActual</strong>
                                    </div>

                                    <div class="summary-item">
                                        <span>@L["Detection"]</span>
                                        <strong>@solicitud.AnalisisRiesgo.DeteccionActual</strong>
                                    </div>

                                    <div class="summary-item rpn-item">
                                        <span>@L["Current RPN"]</span>
                                        <strong>@solicitud.AnalisisRiesgo.RpnActual</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="risk-block">
                                <h3>@L["With Temporary Change"]</h3>

                                <div class="summary-grid three">
                                    <div class="summary-item">
                                        <span>@L["Severity"]</span>
                                        <strong>@solicitud.AnalisisRiesgo.SeveridadActual</strong>
                                    </div>

                                    <div class="summary-item">
                                        <span>@L["Occurrence with Change"]</span>
                                        <strong>@solicitud.AnalisisRiesgo.OcurrenciaConCambio</strong>
                                    </div>

                                    <div class="summary-item">
                                        <span>@L["Detection with Change"]</span>
                                        <strong>@solicitud.AnalisisRiesgo.DeteccionConCambio</strong>
                                    </div>

                                    <div class="summary-item rpn-item">
                                        <span>@L["RPN with Change"]</span>
                                        <strong>@solicitud.AnalisisRiesgo.RpnConCambio</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state compact">
                            @L["This request is standard or has no risk analysis recorded."]
                        </div>
                    }
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Actions"]</h2>
                            <p class="panel-subtitle">@L["Actions proposed or recorded for the deviation."]</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@L["{0} action(s)", solicitud.Acciones.Count]</span>
                    </div>

                    @if (!solicitud.Acciones.Any())
                    {
                        <div class="empty-state compact">@L["No actions recorded."]</div>
                    }
                    else
                    {
                        <div class="action-list">
                            @foreach (var accion in solicitud.Acciones.OrderBy(x => x.Id))
                            {
                                <article class="action-card">
                                    <div class="action-card-head">
                                        <div>
                                            <span>@L["Action"]</span>
                                            <strong>@L["Action #{0}", accion.Id]</strong>
                                        </div>

                                        @if (accion.FechaCompromiso.HasValue)
                                        {
                                            <span class="date-chip">
                                                @L["Commitment: {0}", FormatDate(accion.FechaCompromiso)]
                                            </span>
                                        }
                                    </div>

                                    <p>@Texto(accion.DescripcionAccion)</p>

                                    <div class="action-meta">
                                        <span><strong>@L["Responsible:"]</strong> @Texto(accion.Responsable)</span>
                                        <span><strong>@L["Created:"]</strong> @FormatDateTime(accion.FechaCreacion)</span>
                                    </div>

                                    @if (accion.Archivos.Any())
                                    {
                                        <div class="inline-files">
                                            @foreach (var archivo in accion.Archivos)
                                            {
                                                <a href="@archivo.RutaRelativa.TrimStart('/')" target="_blank">@archivo.NombreOriginal</a>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Extensions"]</h2>
                            <p class="panel-subtitle">@L["History of extensions requested for the deviation."]</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@L["{0} extension(s)", solicitud.Extensiones.Count]</span>
                    </div>

                    @if (!solicitud.Extensiones.Any())
                    {
                        <div class="empty-state compact">@L["No extensions recorded."]</div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="mo-table mini-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>@L["Previous validity"]</th>
                                        <th>@L["New validity"]</th>
                                        <th>@L["Status"]</th>
                                        <th>@L["Reason"]</th>
                                        <th>@L["Requested on"]</th>
                                        <th>@L["Approved on"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ext in solicitud.Extensiones.OrderBy(x => x.NumeroExtension))
                                    {
                                        <tr>
                                            <td>@ext.NumeroExtension</td>
                                            <td>@FormatDate(ext.FechaVigenciaAnterior)</td>
                                            <td>@FormatDate(ext.NuevaFechaVigencia)</td>
                                            <td>
                                                <span class="mo-badge @QcDesvEstadoBadge.ClaseExtension(ext.EstadoExtensionCodigo)">@ext.EstadoExtensionCodigo</span>
                                            </td>
                                            <td>@Texto(ext.RazonExtension)</td>
                                            <td>@FormatDateTime(ext.FechaSolicitud)</td>
                                            <td>@FormatDateTime(ext.FechaAprobacion)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Closure Control"]</h2>
                            <p class="panel-subtitle">@L["Information captured at the closure of the deviation."]</p>
                        </div>
                    </div>

                    @if (solicitud.Control is null)
                    {
                        <div class="empty-state compact">@L["The deviation has no closure data yet."]</div>
                    }
                    else
                    {
                        <div class="summary-grid three">
                            <div class="summary-item">
                                <span>@L["Start Lot"]</span>
                                <strong>@Texto(solicitud.Control.NumeroLoteInicio)</strong>
                            </div>

                            <div class="summary-item">
                                <span>@L["Start Case"]</span>
                                <strong>@Texto(solicitud.Control.NumeroCaseInicio)</strong>
                            </div>

                            <div class="summary-item">
                                <span>@L["Final Lot"]</span>
                                <strong>@Texto(solicitud.Control.NumeroLoteFinal)</strong>
                            </div>

                            <div class="summary-item">
                                <span>@L["Final Case"]</span>
                                <strong>@Texto(solicitud.Control.NumeroCaseFinal)</strong>
                            </div>

                            <div class="summary-item">
                                <span>@L["Closure Date"]</span>
                                <strong>@FormatDateTime(solicitud.Control.FechaCierre)</strong>
                            </div>
                        </div>
                    }
                </section>
            </main>

            <aside class="side-stack compact-side">
                <section class="panel-card compact-panel">
                    <div class="panel-head compact-head">
                        <div>
                            <h2>@L["Approvals"]</h2>
                            <p class="panel-subtitle">@L["Grouped by initial request and extensions."]</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@solicitud.Aprobaciones.Count</span>
                    </div>

                    @if (!solicitud.Aprobaciones.Any())
                    {
                        <div class="empty-state compact">@L["No approvals recorded."]</div>
                    }
                    else
                    {
                        <div class="approval-scroll">
                            @foreach (var grupo in AprobacionesAgrupadas)
                            {
                                <details class="approval-group" open="@grupo.Abierto">
                                    <summary>
                                        <span>@grupo.Titulo</span>
                                        <strong>@L["{0} step(s)", grupo.Items.Count]</strong>
                                    </summary>

                                    <div class="approval-list compact">
                                        @foreach (var aprobacion in grupo.Items.OrderBy(x => x.Orden))
                                        {
                                            <div class="approval-item @(aprobacion.EsPasoActual ? "current" : "")">
                                                <div class="approval-topline">
                                                    <span class="approval-step">@aprobacion.Orden</span>
                                                    <div>
                                                        <strong>@CatalogoTexto.Nombre(aprobacion.RolAprobador?.NombreEs, aprobacion.RolAprobador?.NombreEn)</strong>
                                                    </div>
                                                </div>

                                                <div class="approval-status-line">
                                                    <span class="mo-badge @QcDesvEstadoBadge.ClaseAprobacion(aprobacion.EstadoAprobacionCodigo)">
                                                        @TextoAprobacion(aprobacion)
                                                    </span>

                                                    @if (aprobacion.EsPasoActual)
                                                    {
                                                        <span class="mo-badge mo-badge-primary">@L["Current"]</span>
                                                    }
                                                </div>

                                                <div class="approval-meta">
                                                    <span>@L["Assigned: {0}", FormatDateTime(aprobacion.FechaAsignacion)]</span>
                                                    <span>@L["Decision: {0}", FormatDateTime(aprobacion.FechaDecision)]</span>
                                                    <span>@L["Approver: {0}", Texto(aprobacion.UsuarioAprobador?.NombreCompleto)]</span>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(aprobacion.Comentarios))
                                                {
                                                    <p class="approval-comment">@aprobacion.Comentarios</p>
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }
                </section>

                <section class="panel-card compact-panel">
                    <div class="panel-head compact-head">
                        <div>
                            <h2>@L["Files"]</h2>
                            <p class="panel-subtitle">@L["Attachments related to the request."]</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@solicitud.Archivos.Count</span>
                    </div>

                    @if (!solicitud.Archivos.Any())
                    {
                        <div class="empty-state compact">@L["No attached files."]</div>
                    }
                    else
                    {
                        <div class="file-list compact-files">
                            @foreach (var archivo in solicitud.Archivos.OrderByDescending(x => x.FechaSubida))
                            {
                                <a href="@archivo.RutaRelativa.TrimStart('/')" target="_blank">
                                    <strong>@archivo.NombreOriginal</strong>
                                    <span>@FormatDateTime(archivo.FechaSubida)</span>
                                </a>
                            }
                        </div>
                    }
                </section>

                <section class="panel-card compact-panel">
                    <div class="panel-head compact-head">
                        <div>
                            <h2>@L["History"]</h2>
                            <p class="panel-subtitle">@L["Movements of the deviation."]</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@solicitud.Historiales.Count</span>
                    </div>

                    @if (!solicitud.Historiales.Any())
                    {
                        <div class="empty-state compact">@L["No history recorded."]</div>
                    }
                    else
                    {
                        <div class="history-scroll">
                            <div class="history-timeline">
                                @foreach (var h in solicitud.Historiales.OrderByDescending(x => x.FechaMovimiento))
                                {
                                    <article class="history-item timeline-item">
                                        <div class="timeline-dot"></div>

                                        <div>
                                            <strong>@h.Accion</strong>
                                            <span>@FormatDateTime(h.FechaMovimiento)</span>

                                            @if (!string.IsNullOrWhiteSpace(h.EstadoAnteriorCodigo) || !string.IsNullOrWhiteSpace(h.EstadoNuevoCodigo))
                                            {
                                                <div class="history-status">
                                                    @Texto(h.EstadoAnteriorCodigo) → @Texto(h.EstadoNuevoCodigo)
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(h.Comentario))
                                            {
                                                <p>@h.Comentario</p>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    }
                </section>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    private QcDesvSolicitud? solicitud;
    private bool cargando = true;
    private int usuarioActualId;

    private bool PuedeSolicitarExtension =>
        solicitud is not null &&
        solicitud.NumeroExtensionActual < 2 &&
        (
            solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Aprobada ||
            solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.ExtensionAprobada
        );

    private bool PuedeCerrar =>
        solicitud is not null &&
        (
            solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Aprobada ||
            solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.ExtensionAprobada
        );

    private bool EsSolicitanteActual =>
        solicitud is not null &&
        solicitud.UsuarioSolicitanteId == usuarioActualId;

    private bool PuedeEditar =>
        EsSolicitanteActual &&
        (
            solicitud!.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Borrador ||
            solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Rechazada
        );

    private IReadOnlyList<GrupoAprobacionesDetalle> AprobacionesAgrupadas
    {
        get
        {
            if (solicitud is null)
            {
                return Array.Empty<GrupoAprobacionesDetalle>();
            }

            var grupos = new List<GrupoAprobacionesDetalle>();

            var inicial = solicitud.Aprobaciones
                .Where(x => x.ExtensionId is null)
                .OrderBy(x => x.Orden)
                .ToList();

            if (inicial.Any())
            {
                grupos.Add(new GrupoAprobacionesDetalle
                {
                    Titulo = L["Initial request"].Value,
                    Abierto = true,
                    Items = inicial
                });
            }

            var gruposExtension = solicitud.Aprobaciones
                .Where(x => x.ExtensionId.HasValue)
                .GroupBy(x => x.ExtensionId!.Value)
                .OrderBy(x => NumeroExtension(x.Key));

            foreach (var grupo in gruposExtension)
            {
                var extension = solicitud.Extensiones.FirstOrDefault(x => x.Id == grupo.Key);
                var numero = extension?.NumeroExtension.ToString() ?? grupo.Key.ToString();

                grupos.Add(new GrupoAprobacionesDetalle
                {
                    Titulo = L["Extension #{0}", numero].Value,
                    Abierto = grupo.Any(x => x.EsPasoActual),
                    Items = grupo.OrderBy(x => x.Orden).ToList()
                });
            }

            return grupos;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();
        solicitud = await SolicitudService.ObtenerDetalleAsync(SolicitudId);
        cargando = false;
    }

    private int NumeroExtension(int extensionId)
    {
        if (solicitud is null)
        {
            return 0;
        }

        return solicitud.Extensiones
            .FirstOrDefault(x => x.Id == extensionId)?
            .NumeroExtension ?? 0;
    }

    private static string Texto(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    private static string SiNo(bool value)
    {
        return value ? Loc.T("Yes") : Loc.T("No");
    }

    private static string FormatDate(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "—";
    }

    private static string FormatDateTime(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm") : "—";
    }

    private static string TextoAprobacion(QcDesvAprobacion aprobacion)
    {
        return aprobacion.EstadoAprobacion is null
            ? aprobacion.EstadoAprobacionCodigo
            : CatalogoTexto.Nombre(aprobacion.EstadoAprobacion.NombreEs, aprobacion.EstadoAprobacion.NombreEn);
    }

    private sealed class GrupoAprobacionesDetalle
    {
        public string Titulo { get; set; } = string.Empty;
        public bool Abierto { get; set; }
        public List<QcDesvAprobacion> Items { get; set; } = new();
    }
}