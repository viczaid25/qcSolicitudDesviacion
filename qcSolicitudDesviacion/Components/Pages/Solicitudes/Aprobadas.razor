@page "/solicitudes/aprobadas"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService

<PageTitle>@L["Approved deviations"]</PageTitle>

<div class="aprobadas-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">@L["Approved deviations"]</div>
            <div id="mo-banner-title">@L["Approved deviations"]</div>
            <div id="mo-banner-sub">
                @L["View approved deviations, generate a shareable sheet, download it as an image or print it."]
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-secondary-outline" href="desviaciones">
                @L["Deviations"]
            </a>

            <a class="mo-btn mo-btn-primary" href="solicitudes/crear">
                @L["New Deviation"]
            </a>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-head">
            <div>
                <h2>@L["List"]</h2>
                <p class="panel-subtitle">@L["Only approved requests, with approved extension or closed."]</p>
            </div>

            <span class="mo-badge mo-badge-primary">
                <span class="mo-badge-dot"></span>@L["{0} records", SolicitudesFiltradas.Count()]
            </span>
        </div>

        <div class="approved-filters">
            <div>
                <label class="mo-form-label">@L["Search"]</label>
                <input class="mo-form-control"
                       placeholder="@L["ID, part, customer, requester..."]"
                       @bind="filtro"
                       @bind:event="oninput" />
            </div>
        </div>

        @if (cargando)
        {
            <div class="empty-state">
                @L["Loading approved requests..."]
            </div>
        }
        else if (!SolicitudesFiltradas.Any())
        {
            <div class="empty-state">
                @L["There are no approved deviations to show."]
            </div>
        }
        else
        {
            <div class="mo-table-wrap" data-mo-table data-page-size="10">
                <table class="mo-table">
                    <thead>
                        <tr>
                            <th data-mo-sort-col="0">ID</th>
                            <th data-mo-sort-col="1">@L["Part / Customer"]</th>
                            <th data-mo-sort-col="2">@L["Applicant"]</th>
                            <th data-mo-sort-col="3">@L["Request Date"]</th>
                            <th data-mo-sort-col="4">@L["Validity"]</th>
                            <th data-mo-sort-col="5">@L["Status"]</th>
                            <th></th>
                        </tr>
                        <tr class="mo-table-filter-row">
                            <th><input class="mo-th-filter" data-mo-filter-col="0" placeholder="@L["Filter..."]" /></th>
                            <th><input class="mo-th-filter" data-mo-filter-col="1" placeholder="@L["Filter..."]" /></th>
                            <th><input class="mo-th-filter" data-mo-filter-col="2" placeholder="@L["Filter..."]" /></th>
                            <th><input class="mo-th-filter" data-mo-filter-col="3" placeholder="@L["Filter..."]" /></th>
                            <th><input class="mo-th-filter" data-mo-filter-col="4" placeholder="@L["Filter..."]" /></th>
                            <th>
                                <select class="mo-th-filter" data-mo-filter-col="5">
                                    <option value="">@L["All"]</option>
                                    <option value="@L["Closed"]">@L["Closed"]</option>
                                    <option value="@L["Expired"]">@L["Expired"]</option>
                                    <option value="@L["Valid"]">@L["Valid"]</option>
                                </select>
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in SolicitudesFiltradas)
                        {
                            <tr>
                                <td data-sort-value="@item.SolicitudId">#@item.SolicitudId</td>
                                <td>
                                    <div class="cell-title">@Texto(item.NumeroParteAfectado)</div>
                                    <div class="cell-subtitle">@Texto(item.Clientes)</div>
                                </td>
                                <td>@Texto(item.NombreSolicitante)</td>
                                <td data-sort-value="@item.FechaSolicitud.ToString("yyyy-MM-dd")">@item.FechaSolicitud.ToString("yyyy-MM-dd")</td>
                                <td data-sort-value="@item.FechaVigencia.ToString("yyyy-MM-dd")">@item.FechaVigencia.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="mo-badge @EstadoVigenciaBadgeClase(item)">
                                        <span class="mo-badge-dot"></span>@EstadoVigenciaTexto(item)
                                    </span>
                                </td>
                                <td class="text-end approved-actions">
                                    <a class="mo-btn mo-btn-primary mo-btn-sm"
                                       href="solicitudes/@item.SolicitudId/compartir">
                                        @L["Sheet"]
                                    </a>

                                    <a class="mo-btn mo-btn-secondary-outline mo-btn-sm"
                                       href="solicitudes/@item.SolicitudId">
                                        @L["Detail"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mo-table-pagination" data-mo-pagination></div>
        }
    </section>
</div>

@code {
    private bool cargando = true;
    private string filtro = string.Empty;

    private List<QcDesvSolicitudResumen> solicitudes = new();

    private IEnumerable<QcDesvSolicitudResumen> SolicitudesFiltradas
    {
        get
        {
            var query = solicitudes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtro))
            {
                var valor = filtro.Trim();

                query = query.Where(x =>
                    x.SolicitudId.ToString().Contains(valor, StringComparison.OrdinalIgnoreCase) ||
                    Contiene(x.NumeroParteAfectado, valor) ||
                    Contiene(x.Clientes, valor) ||
                    Contiene(x.NombreSolicitante, valor) ||
                    Contiene(x.EstadoSolicitudEs, valor));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var resumen = await SolicitudService.ObtenerResumenAsync();

        solicitudes = resumen
            .Where(EsCompartible)
            .OrderByDescending(x => x.SolicitudId)
            .ToList();

        cargando = false;
    }

    private static bool EsCompartible(QcDesvSolicitudResumen solicitud)
    {
        return solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Aprobada ||
               solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.ExtensionAprobada ||
               solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cerrada;
    }

    private static bool EstaVencida(QcDesvSolicitudResumen solicitud)
    {
        if (solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cerrada)
        {
            return false;
        }

        return solicitud.FechaVigencia.Date < DateTime.Today;
    }

    private static string EstadoVigenciaTexto(QcDesvSolicitudResumen solicitud)
    {
        if (solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cerrada)
        {
            return Loc.T("Closed");
        }

        return EstaVencida(solicitud)
            ? Loc.T("Expired")
            : Loc.T("Valid");
    }

    private static string EstadoVigenciaBadgeClase(QcDesvSolicitudResumen solicitud)
    {
        return EstadoVigenciaClass(solicitud) switch
        {
            "closed" => "mo-badge-secondary",
            "expired" => "mo-badge-danger",
            _ => "mo-badge-success"
        };
    }

    private static string EstadoVigenciaClass(QcDesvSolicitudResumen solicitud)
    {
        if (solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cerrada)
        {
            return "closed";
        }

        return EstaVencida(solicitud)
            ? "expired"
            : "active";
    }

    private static bool Contiene(string? texto, string filtro)
    {
        return !string.IsNullOrWhiteSpace(texto) &&
               texto.Contains(filtro, StringComparison.OrdinalIgnoreCase);
    }

    private static string Texto(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    }
}