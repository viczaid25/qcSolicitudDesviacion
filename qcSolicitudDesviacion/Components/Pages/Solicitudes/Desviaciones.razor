@page "/desviaciones"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService

<PageTitle>@L["Deviations"]</PageTitle>

<div class="desv-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">@L["All deviations"]</div>
            <div id="mo-banner-title">@L["Deviations"]</div>
            <div id="mo-banner-sub">
                @L["View all deviations registered by any requester, with their validity status."]
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-secondary-outline" href="solicitudes">
                @L["My Requests"]
            </a>
            <a class="mo-btn mo-btn-primary" href="solicitudes/crear">
                @L["New Deviation"]
            </a>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-head">
            <div>
                <h2>@L["List"]</h2>
                <p class="panel-subtitle">@L["All deviations, with completed ones first."]</p>
            </div>

            <span class="mo-badge mo-badge-primary">
                <span class="mo-badge-dot"></span>@L["{0} records", SolicitudesFiltradas.Count()]
            </span>
        </div>

        <div class="desv-filters">
            <div class="field-with-help">
                <label class="mo-form-label">@L["Search"]</label>
                <input class="mo-form-control"
                       placeholder="@L["ID, line, BU, customer, requester..."]"
                       @bind="filtro"
                       @bind:event="oninput" />
            </div>

            <div class="field-with-help">
                <label class="mo-form-label">@L["Status"]</label>
                <select class="mo-form-select" @bind="estadoFiltro">
                    <option value="">@L["All"]</option>
                    <option value="COMPLETADAS">@L["Closed"]</option>
                    <option value="VENCIDAS">@L["Expired"]</option>
                    <option value="POR_VENCER">@L["Expiring soon"]</option>
                    <option value="VIGENTES">@L["Valid"]</option>
                </select>
            </div>
        </div>

        @if (cargando)
        {
            <div class="empty-state">
                @L["Loading deviations..."]
            </div>
        }
        else if (!SolicitudesFiltradas.Any())
        {
            <div class="empty-state">
                @L["There are no deviations to show with the current filters."]
            </div>
        }
        else
        {
            <div class="mo-table-wrap" data-mo-table data-page-size="10">
                <table class="mo-table">
                    <thead>
                        <tr>
                            <th data-mo-sort-col="0">ID</th>
                            <th data-mo-sort-col="1">@L["Part / Customer"]</th>
                            <th data-mo-sort-col="2">@L["Requester"]</th>
                            <th data-mo-sort-col="3">@L["Line / BU"]</th>
                            <th data-mo-sort-col="4">@L["Validity"]</th>
                            <th data-mo-sort-col="5">@L["Request Status"]</th>
                            <th data-mo-sort-col="6">@L["Extension Status"]</th>
                            <th></th>
                        </tr>
                        <tr class="mo-table-filter-row">
                            <th><input class="mo-th-filter" data-mo-filter-col="0" placeholder="@L["Filter..."]" /></th>
                            <th><input class="mo-th-filter" data-mo-filter-col="1" placeholder="@L["Filter..."]" /></th>
                            <th><input class="mo-th-filter" data-mo-filter-col="2" placeholder="@L["Filter..."]" /></th>
                            <th><input class="mo-th-filter" data-mo-filter-col="3" placeholder="@L["Filter..."]" /></th>
                            <th><input class="mo-th-filter" data-mo-filter-col="4" placeholder="@L["Filter..."]" /></th>
                            <th>
                                <select class="mo-th-filter" data-mo-filter-col="5">
                                    <option value="">@L["All"]</option>
                                    @foreach (var estado in EstadosVigenciaDisponibles)
                                    {
                                        <option value="@estado">@estado</option>
                                    }
                                </select>
                            </th>
                            <th><input class="mo-th-filter" data-mo-filter-col="6" placeholder="@L["Filter..."]" /></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in SolicitudesFiltradas)
                        {
                            var solicitud = item.Solicitud;

                            <tr>
                                <td data-sort-value="@solicitud.SolicitudId">#@solicitud.SolicitudId</td>

                                <td>
                                    <div class="cell-title">@Texto(solicitud.NumeroParteAfectado)</div>
                                    <div class="cell-subtitle">@Texto(solicitud.Clientes)</div>
                                </td>

                                <td>@Texto(solicitud.NombreSolicitante)</td>

                                <td>@Texto(solicitud.CodigoLinea) · @Texto(solicitud.UnidadNegocioAfectada)</td>

                                <td data-sort-value="@solicitud.FechaVigencia.ToString("yyyy-MM-dd")">
                                    @solicitud.FechaVigencia.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    <span class="mo-badge @EstadoVigenciaBadgeClase(solicitud)">
                                        <span class="mo-badge-dot"></span>@EstadoVigenciaTexto(solicitud)
                                    </span>
                                </td>

                                <td class="desv-ext-cell">
                                    @if (item.Extensiones.Count == 0)
                                    {
                                        <span class="desv-muted">—</span>
                                    }
                                    else
                                    {
                                        @foreach (var ext in item.Extensiones.OrderBy(x => x.NumeroExtension))
                                        {
                                            <span class="mo-badge @EstadoExtensionBadgeClase(ext)">
                                                <span class="mo-badge-dot"></span>@L["Ext. {0}: {1}", ext.NumeroExtension, Texto(CatalogoTexto.Nombre(ext.EstadoExtensionEs, ext.EstadoExtensionEn))]
                                            </span>
                                        }
                                    }
                                </td>

                                <td class="text-end desv-actions">
                                    @if (EsCompartible(solicitud))
                                    {
                                        <a class="mo-btn mo-btn-primary mo-btn-sm"
                                           href="solicitudes/@solicitud.SolicitudId/compartir">
                                            @L["Sheet"]
                                        </a>
                                    }

                                    <a class="mo-btn mo-btn-secondary-outline mo-btn-sm"
                                       href="solicitudes/@solicitud.SolicitudId">
                                        @L["Detail"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mo-table-pagination" data-mo-pagination></div>
        }
    </section>
</div>

@code {
    private const int DiasPorVencer = 15;

    private bool cargando = true;
    private string filtro = string.Empty;
    private string estadoFiltro = string.Empty;

    private List<QcDesvSolicitudConExtensiones> solicitudes = new();

    private IEnumerable<QcDesvSolicitudConExtensiones> SolicitudesFiltradas
    {
        get
        {
            var query = solicitudes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtro))
            {
                var valor = filtro.Trim();

                query = query.Where(x =>
                    x.Solicitud.SolicitudId.ToString().Contains(valor, StringComparison.OrdinalIgnoreCase) ||
                    Contiene(x.Solicitud.CodigoLinea, valor) ||
                    Contiene(x.Solicitud.UnidadNegocioAfectada, valor) ||
                    Contiene(x.Solicitud.Clientes, valor) ||
                    Contiene(x.Solicitud.NombreSolicitante, valor) ||
                    Contiene(x.Solicitud.EstadoSolicitudEs, valor));
            }

            query = estadoFiltro switch
            {
                "COMPLETADAS" => query.Where(x => EstaCompletada(x.Solicitud)),
                "VENCIDAS" => query.Where(x => EstaVencida(x.Solicitud)),
                "POR_VENCER" => query.Where(x => EstaPorVencer(x.Solicitud)),
                "VIGENTES" => query.Where(x => EstadoVigenciaClass(x.Solicitud) == "active"),
                _ => query
            };

            // Orden por default: ID de mayor a menor. El ordenamiento fino por
            // columna lo hace el cliente (mo-table.js) sobre las filas ya
            // renderizadas.
            return query.OrderByDescending(x => x.Solicitud.SolicitudId);
        }
    }

    private IEnumerable<string> EstadosVigenciaDisponibles =>
        solicitudes
            .Select(x => EstadoVigenciaTexto(x.Solicitud))
            .Distinct()
            .OrderBy(x => x);

    protected override async Task OnInitializedAsync()
    {
        solicitudes = await SolicitudService.ObtenerResumenConExtensionesAsync();
        cargando = false;
    }

    private static bool EstaCompletada(QcDesvSolicitudResumen solicitud)
    {
        return solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cerrada;
    }

    // Solo tiene sentido hablar de vigencia (Vigente / Por vencer / Vencida) una
    // vez que la solicitud ya fue aprobada: mientras está en revisión, su fecha
    // de vigencia todavía no aplica y no debe mostrarse como "Por vencer".
    private static bool EstaAprobada(QcDesvSolicitudResumen solicitud)
    {
        return solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Aprobada ||
               solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.ExtensionAprobada ||
               solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cerrada;
    }

    private static bool EstaFinalizadaSinAprobar(QcDesvSolicitudResumen solicitud)
    {
        return solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Rechazada ||
               solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cancelada;
    }

    private static bool EstaVencida(QcDesvSolicitudResumen solicitud)
    {
        return EstaAprobada(solicitud) &&
               !EstaCompletada(solicitud) &&
               solicitud.FechaVigencia.Date < DateTime.Today;
    }

    private static bool EstaPorVencer(QcDesvSolicitudResumen solicitud)
    {
        if (!EstaAprobada(solicitud) || EstaCompletada(solicitud))
        {
            return false;
        }

        var dias = (solicitud.FechaVigencia.Date - DateTime.Today).TotalDays;

        return dias >= 0 && dias <= DiasPorVencer;
    }

    private static bool EsCompartible(QcDesvSolicitudResumen solicitud)
    {
        return solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Aprobada ||
               solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.ExtensionAprobada ||
               solicitud.EstadoSolicitudCodigo == QcDesvCodigos.EstadoSolicitud.Cerrada;
    }

    private static string EstadoVigenciaTexto(QcDesvSolicitudResumen solicitud)
    {
        if (EstaCompletada(solicitud))
        {
            return Loc.T("Closed");
        }

        if (EstaFinalizadaSinAprobar(solicitud))
        {
            return CatalogoTexto.Nombre(solicitud.EstadoSolicitudEs, solicitud.EstadoSolicitudEn);
        }

        if (!EstaAprobada(solicitud))
        {
            return Loc.T("In process");
        }

        if (EstaVencida(solicitud))
        {
            return Loc.T("Expired");
        }

        if (EstaPorVencer(solicitud))
        {
            return Loc.T("Expiring soon");
        }

        return Loc.T("Valid");
    }

    private static string EstadoVigenciaBadgeClase(QcDesvSolicitudResumen solicitud)
    {
        return EstadoVigenciaClass(solicitud) switch
        {
            "closed" => "mo-badge-secondary",
            "expired" => "mo-badge-danger",
            "expiring" => "mo-badge-warning",
            "inactive" => "mo-badge-secondary",
            "in_progress" => "mo-badge-primary",
            _ => "mo-badge-success"
        };
    }

    private static string EstadoVigenciaClass(QcDesvSolicitudResumen solicitud)
    {
        if (EstaCompletada(solicitud))
        {
            return "closed";
        }

        if (EstaFinalizadaSinAprobar(solicitud))
        {
            return "inactive";
        }

        if (!EstaAprobada(solicitud))
        {
            return "in_progress";
        }

        if (EstaVencida(solicitud))
        {
            return "expired";
        }

        if (EstaPorVencer(solicitud))
        {
            return "expiring";
        }

        return "active";
    }

    private static string EstadoExtensionBadgeClase(QcDesvExtensionResumen extension)
    {
        return extension.EstadoExtensionCodigo switch
        {
            QcDesvCodigos.EstadoExtension.Aprobada => "mo-badge-success",
            QcDesvCodigos.EstadoExtension.Rechazada => "mo-badge-danger",
            QcDesvCodigos.EstadoExtension.Cancelada => "mo-badge-secondary",
            _ => "mo-badge-primary"
        };
    }

    private static bool Contiene(string? texto, string filtro)
    {
        return !string.IsNullOrWhiteSpace(texto) &&
               texto.Contains(filtro, StringComparison.OrdinalIgnoreCase);
    }

    private static string Texto(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    }
}
