@page "/solicitudes/crear"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService
@inject CatalogoService CatalogoService
@inject ArchivoService ArchivoService
@inject UsuarioActualService UsuarioActualService
@inject AdminAprobadoresService AdminAprobadoresService
@inject NavigationManager Navigation

<PageTitle>Nueva solicitud de desviación</PageTitle>

<div class="nueva-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">Nueva desviación / New deviation</div>
            <div id="mo-banner-title">Solicitud de desviación / Deviation Request</div>
            <div id="mo-banner-sub">
                Captura la información requerida para iniciar el flujo de revisión y aprobación.
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-secondary-outline" href="solicitudes">Volver / Back</a>
        </div>
    </section>

    @if (cargando)
    {
        <div class="nueva-loading">
            <div class="nueva-skeleton nueva-skeleton-form"></div>
        </div>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="@GuardarAsync">
            <div class="main-stack">
                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>Información general / General Information</h2>
                            <p class="panel-subtitle">Datos principales de la solicitud.</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">Paso 1 / Step 1</span>
                    </div>

                    <div class="form-grid">
                        <div class="field-with-help"
                             data-help="Nombre del usuario autenticado. Este dato se toma automáticamente de la sesión y no se puede modificar.">
                            <label class="mo-form-label">
                                Nombre del solicitante / Applicant Name
                                <span class="field-help-icon">?</span>
                            </label>

                            <input class="mo-form-control readonly-control"
                                   value="@model.NombreSolicitante"
                                   readonly />
                        </div>

                        <div class="field-with-help"
                             data-help="Fecha en que se crea la solicitud. Este dato se asigna automáticamente y no se puede modificar.">
                            <label class="mo-form-label">
                                Fecha / Date
                                <span class="field-help-icon">?</span>
                            </label>

                            <input type="date"
                                   class="mo-form-control readonly-control"
                                   value="@FechaSolicitudTexto"
                                   readonly />
                        </div>

                        <div class="field-with-help"
                             data-help="Departamento del solicitante. Se obtiene automáticamente desde dbo.meax_all_user usando el usuario autenticado.">
                            <label class="mo-form-label">
                                Departamento solicitante / Requesting Department
                                <span class="field-help-icon">?</span>
                            </label>

                            <input class="mo-form-control readonly-control"
                                   value="@model.DepartamentoSolicitante"
                                   readonly />

                            <div class="field-help">
                                Departamento obtenido desde meax_all_user.
                            </div>
                        </div>

                        <div class="field-with-help"
                             data-help="Seleccione la unidad de negocio afectada por la desviación. Este dato identifica el área principal donde aplica el cambio temporal.">
                            <label class="mo-form-label">
                                Unidad de negocio afectada / Affected Business Unit
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputSelect class="mo-form-select" @bind-Value="model.UnidadNegocioAfectada">
                                <option value="">Seleccione / Select</option>

                                @foreach (var unidad in UnidadesNegocio)
                                {
                                    <option value="@unidad">@unidad</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="field-with-help"
                             data-help="Seleccione el código de línea, proceso o área donde se aplicará la desviación temporal.">
                            <label class="mo-form-label">
                                Código de la línea / Line Code
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputSelect class="mo-form-select" @bind-Value="model.CodigoLinea">
                                <option value="">Seleccione / Select</option>

                                @foreach (var linea in CodigosLinea)
                                {
                                    <option value="@linea">@linea</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="field-with-help help-right"
                             data-help="Seleccione si la desviación es crítica o estándar. Si selecciona estándar, el análisis de riesgo no será requerido.">
                            <label class="mo-form-label">
                                Tipo de desviación / Deviation Type
                                <span class="field-help-icon">?</span>
                            </label>

                            <div class="tipo-desviacion-options">
                                @foreach (var tipo in tiposDesviacion)
                                {
                                    <button type="button"
                                            class="tipo-desviacion-btn @(tipo.Codigo == QcDesvCodigos.TipoDesviacion.Critica ? "critica" : "estandar") @(model.TipoDesviacionCodigo == tipo.Codigo ? "selected" : "")"
                                            @onclick="() => SeleccionarTipoDesviacion(tipo.Codigo)">
                                        <span class="tipo-desviacion-nombre">@tipo.NombreEs</span>
                                        <span class="tipo-desviacion-nombre-en">@tipo.NombreEn</span>
                                    </button>
                                }
                            </div>

                            <div class="field-help">
                                Si seleccionas Estándar, se omitirá el análisis de riesgo.
                            </div>
                        </div>

                        <div class="field-with-help"
                             data-help="Fecha hasta la cual será válida la desviación temporal. No debe ser menor a la fecha de solicitud.">
                            <label class="mo-form-label">
                                Tiempo de vigencia / Validity Period
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputDate class="mo-form-control" @bind-Value="model.FechaVigencia" />
                        </div>

                        <div class="field-with-help"
                             data-help="Cantidad estimada de piezas afectadas por la desviación. Este campo es opcional, pero si se captura debe ser mayor a cero.">
                            <label class="mo-form-label">
                                Cantidad de piezas / Quantity of Pieces
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputNumber class="mo-form-control" @bind-Value="model.CantidadPiezas" />

                            <div class="field-help">
                                Campo opcional. Si se captura, debe ser mayor a 0.
                            </div>
                        </div>

                        <div class="field-with-help"
                             data-help="Número de parte, modelo o componente afectado por la desviación temporal.">
                            <label class="mo-form-label">
                                Número de parte afectado / Affected Part Number
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputText class="mo-form-control" @bind-Value="model.NumeroParteAfectado" />
                        </div>

                        <div class="field-with-help help-right"
                             data-help="Seleccione la categoría 6M relacionada con la desviación: Método, Materia, Mano de obra, Máquina, Medición u Otro.">
                            <label class="mo-form-label">
                                6M
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputSelect class="mo-form-select" @bind-Value="model.RequisitoProcesoCodigo">
                                <option value="">Seleccione / Select</option>
                                @foreach (var requisito in requisitosProceso)
                                {
                                    <option value="@requisito.Codigo">@requisito.NombreEs / @requisito.NombreEn</option>
                                }
                            </InputSelect>

                            <div class="field-help">
                                Seleccione la categoría 6M aplicable / Select the applicable 6M category.
                            </div>
                        </div>

                        @if (model.RequisitoProcesoCodigo == QcDesvCodigos.RequisitoProceso.Otro)
                        {
                            <div class="field-with-help"
                                 data-help="Capture la categoría 6M cuando la opción seleccionada sea Otro.">
                                <label class="mo-form-label">
                                    Especifique otro / Specify other
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputText class="mo-form-control" @bind-Value="model.RequisitoProcesoOtro" />
                            </div>
                        }
                    </div>

                    <div class="section-divider"></div>

                    <div class="client-csr-card">
                        <div class="client-csr-head">
                            <div>
                                <h3>Cliente y CSR / Customer and CSR</h3>
                                <p>Capture el cliente y agregue todos los CSR necesarios.</p>
                            </div>
                        </div>

                        <div class="form-grid two">
                            <div class="customer-dynamic-block field-with-help"
                                 data-help="Capture el cliente o clientes impactados por la desviación. Puede agregar todos los clientes necesarios.">
                                <div class="customer-dynamic-head">
                                    <div>
                                        <label class="mo-form-label">
                                            Cliente(s) / Customer(s)
                                            <span class="field-help-icon">?</span>
                                        </label>
                                        <p>Agregue todos los clientes necesarios / Add all required customers.</p>
                                    </div>

                                    <button type="button"
                                            class="mo-btn mo-btn-primary mo-btn-sm"
                                            @onclick="AgregarCliente">
                                        Agregar cliente / Add Customer
                                    </button>
                                </div>

                                <div class="customer-list">
                                    @for (var i = 0; i < clientes.Count; i++)
                                    {
                                        var index = i;

                                        <div class="customer-row">
                                            <div class="customer-number">
                                                @(index + 1)
                                            </div>

                                            <input class="mo-form-control"
                                                   value="@clientes[index]"
                                                   placeholder="Cliente @(index + 1)"
                                                   @oninput="e => ActualizarCliente(index, e.Value?.ToString())" />

                                            @if (clientes.Count > 1)
                                            {
                                                <button type="button"
                                                        class="mo-btn mo-btn-danger-outline mo-btn-sm"
                                                        @onclick="() => QuitarCliente(index)">
                                                    Quitar / Remove
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="csr-dynamic-block field-with-help help-right"
                                 data-help="Capture los requisitos específicos del cliente relacionados con esta desviación. Puede agregar tantos CSR como sean necesarios.">
                                <div class="csr-dynamic-head">
                                    <div>
                                        <label class="mo-form-label">
                                            CSR
                                            <span class="field-help-icon">?</span>
                                        </label>
                                        <p>Agregue todos los CSR necesarios / Add all required CSRs.</p>
                                    </div>

                                    <button type="button"
                                            class="mo-btn mo-btn-primary mo-btn-sm"
                                            @onclick="AgregarCsr">
                                        Agregar CSR / Add CSR
                                    </button>
                                </div>

                                <div class="csr-list">
                                    @for (var i = 0; i < model.Csrs.Count; i++)
                                    {
                                        var index = i;

                                        <div class="csr-row">
                                            <div class="csr-number">
                                                @(index + 1)
                                            </div>

                                            <input class="mo-form-control"
                                                   value="@model.Csrs[index]"
                                                   placeholder="CSR @(index + 1)"
                                                   @oninput="e => ActualizarCsr(index, e.Value?.ToString())" />

                                            @if (model.Csrs.Count > 1)
                                            {
                                                <button type="button"
                                                        class="mo-btn mo-btn-danger-outline mo-btn-sm"
                                                        @onclick="() => QuitarCsr(index)">
                                                    Quitar / Remove
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <div class="form-grid">
                        <div class="field-with-help"
                             data-help="Seleccione si es necesario informar al cliente sobre el cambio temporal solicitado.">
                            <label class="mo-form-label">
                                ¿Es necesario informar al cliente? / Inform customer?
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputSelect class="mo-form-select" @bind-Value="model.InformarCliente">
                                <option value="false">No / No</option>
                                <option value="true">Sí / Yes</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mt-3 field-with-help"
                         data-help="Explique la razón por la cual es necesario o no informar al cliente del cambio temporal. Si selecciona Sí, este campo es obligatorio.">
                        <label class="mo-form-label">
                            Razón / Reason
                            <span class="field-help-icon">?</span>
                        </label>

                        <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.RazonInformarCliente" />
                    </div>
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>Descripción de la desviación / Deviation Description</h2>
                            <p class="panel-subtitle">Describe el proceso actual y el cambio temporal.</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">Paso 2 / Step 2</span>
                    </div>

                    <div class="stack-fields">
                        <div class="field-with-help"
                             data-help="Describe cómo debe realizarse normalmente el proceso de acuerdo con el método aprobado, instrucción de trabajo, procedimiento, estándar o especificación vigente.">
                            <label class="mo-form-label">
                                ¿Cómo debe realizarse el proceso? / How should the process be performed?
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="3"
                                           @bind-Value="model.ComoDebeRealizarseProceso" />
                        </div>

                        <div class="field-with-help"
                             data-help="Indica los controles actuales que se aplican antes de la desviación, por ejemplo inspecciones, verificaciones, poka-yokes, registros, validaciones, pruebas o revisiones del operador.">
                            <label class="mo-form-label">
                                ¿Qué controles se siguen durante la operación actual? / Current operation controls
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="3"
                                           @bind-Value="model.ControlesOperacionActual" />
                        </div>

                        <div class="field-with-help"
                             data-help="Explica cómo se realizará temporalmente el proceso durante la desviación. Describe claramente qué cambiará contra el proceso normal y cómo se ejecutará el cambio.">
                            <label class="mo-form-label">
                                ¿Cómo se ejecutará el proceso después del cambio temporal? / Process after temporary change
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="3"
                                           @bind-Value="model.ProcesoDespuesCambioTemporal" />
                        </div>

                        <div class="field-with-help"
                             data-help="Describe los controles adicionales o temporales que deberán aplicarse mientras la desviación esté vigente para asegurar que no se afecte calidad, seguridad, cliente o proceso.">
                            <label class="mo-form-label">
                                ¿Qué controles deben implementarse durante el cambio? / Controls during change
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="3"
                                           @bind-Value="model.ControlesDuranteCambio" />
                        </div>
                    </div>
                </section>

                @if (EsCritica)
                {
                    <section class="panel-card">
                        <div class="panel-head">
                            <div>
                                <h2>Análisis de riesgo / Risk Analysis</h2>
                                <p class="panel-subtitle">Aplicable solo para desviación crítica.</p>
                            </div>
                            <span class="mo-badge mo-badge-danger">Crítica / Critical</span>
                        </div>

                        <div class="mo-alert mo-alert-warning">
                            Capture valores de AMEF entre 1 y 10.
                        </div>

                        <div class="section-divider"></div>

                        <label class="mo-form-label">
                            Operación actual conforme al AMEF / Current operation according to FMEA
                        </label>

                        <div class="form-grid three">
                            <div class="field-with-help"
                                 data-help="Valor de severidad del AMEF actual. Evalúa qué tan grave sería el efecto de la falla para el cliente, producto, proceso o seguridad. Capture un valor del 1 al 10.">
                                <label class="mo-form-label">
                                    Severidad / Severity
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.SeveridadActual"
                                             min="1"
                                             max="10" />
                            </div>

                            <div class="field-with-help"
                                 data-help="Valor de ocurrencia del AMEF actual. Indica qué tan probable es que ocurra la falla con el proceso actual. Capture un valor del 1 al 10.">
                                <label class="mo-form-label">
                                    Ocurrencia / Occurrence
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.OcurrenciaActual"
                                             min="1"
                                             max="10" />
                            </div>

                            <div class="field-with-help help-right"
                                 data-help="Valor de detección del AMEF actual. Indica qué tan probable es detectar la falla antes de que llegue al cliente o al siguiente proceso. Capture un valor del 1 al 10.">
                                <label class="mo-form-label">
                                    Detección / Detection
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.DeteccionActual"
                                             min="1"
                                             max="10" />
                            </div>
                        </div>

                        <div class="section-divider"></div>

                        <label class="mo-form-label">
                            Considerando el cambio / Considering the change
                        </label>

                        <div class="form-grid two">
                            <div class="field-with-help"
                                 data-help="Valor de ocurrencia considerando el cambio temporal. Indica qué tan probable es que ocurra la falla después de implementar la desviación. Capture un valor del 1 al 10.">
                                <label class="mo-form-label">
                                    Ocurrencia con cambio / Occurrence with Change
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.OcurrenciaConCambio"
                                             min="1"
                                             max="10" />
                            </div>

                            <div class="field-with-help help-right"
                                 data-help="Valor de detección considerando el cambio temporal. Indica qué tan probable es detectar la falla con los controles temporales propuestos. Capture un valor del 1 al 10.">
                                <label class="mo-form-label">
                                    Detección con cambio / Detection with Change
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.DeteccionConCambio"
                                             min="1"
                                             max="10" />
                            </div>
                        </div>
                    </section>
                }

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>Acciones / Actions</h2>
                            <p class="panel-subtitle">
                                Describe las acciones y adjunta evidencia cuando aplique.
                            </p>
                        </div>
                        <span class="mo-badge mo-badge-primary">Paso 3 / Step 3</span>
                    </div>

                    <div class="stack-fields">
                        <div class="field-with-help"
                             data-help="Describe las acciones que se realizarán para controlar, corregir o mitigar la desviación. Este campo es opcional, pero si capturas una descripción deberás adjuntar al menos un archivo como evidencia o soporte.">
                            <label class="mo-form-label">
                                Descripción de acciones / Action Description
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="4"
                                           @bind-Value="model.DescripcionAccion" />

                            <div class="field-help">
                                Si captura una descripción de acciones, deberá adjuntar al menos un archivo.
                            </div>
                        </div>

                        <div class="field-with-help"
                             data-help="Persona responsable de ejecutar o dar seguimiento a las acciones capturadas.">
                            <label class="mo-form-label">
                                Responsable / Owner
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputText class="mo-form-control" @bind-Value="model.ResponsableAccion" />
                        </div>

                        <div class="field-with-help"
                             data-help="Adjunte archivos de soporte o evidencia cuando capture una descripción de acciones. El tamaño máximo por archivo es 20 MB.">
                            <label class="mo-form-label">
                                Archivos adjuntos / Attachments
                                @if (AccionRequiereAdjunto)
                                {
                                    <span class="required-mark">*</span>
                                }
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputFile class="mo-form-control file-input" OnChange="@SeleccionarArchivos" multiple />

                            <div class="field-help">
                                Tamaño máximo por archivo: 20 MB.
                            </div>

                            @if (AccionRequiereAdjunto && archivosSeleccionados.Count == 0)
                            {
                                <div class="field-warning">
                                    Debe adjuntar al menos un archivo si capturó descripción de acciones.
                                </div>
                            }

                            @if (archivosSeleccionados.Count > 0)
                            {
                                <div class="file-list">
                                    @foreach (var archivo in archivosSeleccionados)
                                    {
                                        <span>@archivo.Name</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>Aprobadores / Approvers</h2>
                            <p class="panel-subtitle">
                                Seleccione el usuario responsable de aprobar cada etapa del flujo.
                            </p>
                        </div>
                        <span class="mo-badge mo-badge-primary">Paso 4 / Step 4</span>
                    </div>

                    <div class="approver-flow-list">
                        <article class="approver-flow-card approver-flow-card-auto">
                            <div class="approver-step">1</div>

                            <div class="approver-info">
                                <h3>QMS</h3>
                                <p>QMS</p>

                                <div class="field-help">
                                    Se asigna automáticamente a los administradores del sistema; no requiere
                                    seleccionar un aprobador. / Automatically assigned to system administrators;
                                    no approver selection required.
                                </div>
                            </div>
                        </article>

                        @if (rolesAprobadores.Count == 0)
                        {
                            <div class="mo-alert mo-alert-danger">
                                No hay aprobadores configurados. Primero configure usuarios en Administración &gt; Aprobadores.
                            </div>
                        }
                        else
                        {
                            @foreach (var rol in rolesAprobadores.OrderBy(x => x.Orden))
                            {
                                <article class="approver-flow-card">
                                    <div class="approver-step">
                                        @rol.Orden
                                    </div>

                                    <div class="approver-info">
                                        <h3>@rol.NombreEs</h3>
                                        <p>@rol.NombreEn</p>

                                        @if (rol.Usuarios.Count == 0)
                                        {
                                            <div class="field-warning">
                                                No hay usuarios activos con este rol.
                                            </div>
                                        }
                                        else
                                        {
                                            <InputSelect TValue="int?"
                                                         class="mo-form-select"
                                                         @bind-Value="rol.UsuarioSeleccionadoId">
                                                <option value="">Seleccione aprobador / Select approver</option>

                                                @foreach (var usuario in rol.Usuarios)
                                                {
                                                    <option value="@usuario.UsuarioId">
                                                        @usuario.NombreCompleto (@usuario.UserName)
                                                    </option>
                                                }
                                            </InputSelect>

                                            <div class="field-help">
                                                Usuarios disponibles para el rol @rol.NombreEs.
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </section>

                <section class="panel-card submit-panel">
                    <div class="panel-head">
                        <div>
                            <h2>Enviar solicitud / Submit Request</h2>
                            <p class="panel-subtitle">
                                Al enviar, la solicitud pasará al flujo de aprobación iniciando con QMS.
                            </p>
                        </div>
                        <span class="mo-badge mo-badge-primary">Final / Submit</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensaje))
                    {
                        <div class="mo-alert @(exito ? "mo-alert-success" : "mo-alert-danger")">
                            @mensaje
                        </div>
                    }

                    <div class="submit-panel-inner">
                        <a class="mo-btn mo-btn-secondary" href="solicitudes">
                            Cancelar / Cancel
                        </a>

                        <button class="mo-btn mo-btn-primary" type="submit" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Crear y enviar / Create and submit")
                        </button>
                    </div>
                </section>
            </div>
        </EditForm>

        @if (mostrarModalCriterios)
        {
            <div class="modal-overlay" @onclick="CerrarModalCriterios">
                <div class="modal-card" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <div>
                            <h3>
                                ¿Qué impacto tiene la falta de cumplimiento identificada durante la revisión del proceso?
                            </h3>
                            <p class="modal-subtitle">
                                <em>What impact does the non-compliance identified during the process review have?</em>
                            </p>
                        </div>

                        <button type="button" class="modal-close" @onclick="CerrarModalCriterios" aria-label="Cerrar">
                            &times;
                        </button>
                    </div>

                    <div class="modal-body">
                        @if (model.TipoDesviacionCodigo == QcDesvCodigos.TipoDesviacion.Critica)
                        {
                            <span class="mo-badge mo-badge-danger">Impacto alto / High impact</span>

                            <ul>
                                <li>
                                    No hay evidencia de la adhesión en la conformidad de un requisito comprometido
                                    con cliente (AMEF, plan de control, instrucción de trabajo, diagrama de flujo,
                                    norma de empaque)
                                </li>
                                <li>Riesgo mayor para el producto final</li>
                            </ul>

                            <p class="modal-en">
                                <em>
                                    There is no evidence of adherence to compliance with a customer-committed
                                    requirement (FMEA, control plan, work instruction, process flow diagram,
                                    packaging standard). Major risk to the final product.
                                </em>
                            </p>
                        }
                        else
                        {
                            <span class="mo-badge mo-badge-primary">Bajo impacto / Low impact</span>

                            <ul>
                                <li>
                                    No hay evidencia de la adhesión en la conformidad de un requisito no
                                    comprometido con cliente (procedimientos, equipos de medición)
                                </li>
                                <li>Sin riesgo apreciable para el producto final</li>
                            </ul>

                            <p class="modal-en">
                                <em>
                                    There is no evidence of adherence to compliance with a requirement not
                                    committed to the customer (procedures, measuring equipment). No appreciable
                                    risk to the final product.
                                </em>
                            </p>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="mo-btn mo-btn-primary" @onclick="CerrarModalCriterios">
                            Entendido / Got it
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private QcDesvSolicitudFormModel model = new();

    private static readonly string[] UnidadesNegocio =
    {
        "Alternator",
        "Starter",
        "CM",
        "Multimedia",
        "CE",
        "EPS"
    };

    private static readonly string[] CodigosLinea =
    {
        "01 SWAT",
        "02 QC Process",
        "04 Ventas",
        "06 APQP/ EC",
        "11 Alternator",
        "12 Rotor",
        "13 Coil Field",
        "14 Molding Machine",
        "15 Bracket Alternator",
        "17 Alternator GX",
        "18 Rectifier",
        "19 Regulator",
        "20 Alternador 03",
        "21 Starter",
        "22 Armature",
        "23 Yoke",
        "24 Switch",
        "25 Relay",
        "26 Brush Holder",
        "29 Starter Bracket",
        "31 VVT",
        "32 OCV",
        "33 VCT",
        "34 VCT 3G",
        "35 VCT 4G",
        "41 MM DA",
        "42 HMI",
        "43 Amplifier",
        "44 R1 - Low",
        "45 CID",
        "51 LCM - Mazda",
        "52 LCM - Honda",
        "53 LCM - Toyota",
        "54 LCM - Honda 27MY",
        "76 ECU Assy",
        "77 MCU Assy",
        "78 PCM/TCU",
        "81 SMT",
        "82 ESD"
    };

    private List<QcDesvCatTipoDesviacion> tiposDesviacion = new();
    private List<QcDesvCatRequisitoProceso> requisitosProceso = new();
    private List<IBrowserFile> archivosSeleccionados = new();
    private List<string> clientes = new() { string.Empty };
    private List<QcDesvAprobadorRolCrearVm> rolesAprobadores = new();

    private bool cargando = true;
    private bool guardando;
    private bool exito;
    private bool mostrarModalCriterios;
    private string mensaje = string.Empty;

    private string FechaSolicitudTexto => model.FechaSolicitud.ToString("yyyy-MM-dd");

    private bool EsCritica => model.TipoDesviacionCodigo == QcDesvCodigos.TipoDesviacion.Critica;

    private bool AccionRequiereAdjunto =>
        !string.IsNullOrWhiteSpace(model.DescripcionAccion);

    protected override async Task OnInitializedAsync()
    {
        tiposDesviacion = await CatalogoService.ObtenerTiposDesviacionAsync();
        requisitosProceso = await CatalogoService.ObtenerRequisitosProcesoAsync();
        rolesAprobadores = await AdminAprobadoresService.ObtenerAprobadoresParaSolicitudAsync();

        var usuario = await UsuarioActualService.ObtenerUsuarioAsync();
        var departamentoMeax = await UsuarioActualService.ObtenerDepartamentoMeaxUsuarioAutenticadoAsync();

        if (usuario is not null)
        {
            model.UsuarioSolicitanteId = usuario.Id;
            model.NombreSolicitante = usuario.NombreCompleto;
            model.DepartamentoSolicitante = departamentoMeax ?? usuario.Departamento ?? string.Empty;

            if (!string.IsNullOrWhiteSpace(usuario.UnidadNegocio) &&
                UnidadesNegocio.Contains(usuario.UnidadNegocio))
            {
                model.UnidadNegocioAfectada = usuario.UnidadNegocio;
            }
        }

        model.FechaSolicitud = DateTime.Today;
        model.FechaVigencia = DateTime.Today;

        if (model.Csrs.Count == 0)
        {
            model.Csrs.Add(string.Empty);
        }

        if (string.IsNullOrWhiteSpace(model.Clientes))
        {
            clientes = new List<string> { string.Empty };
        }
        else
        {
            clientes = model.Clientes
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            if (clientes.Count == 0)
            {
                clientes.Add(string.Empty);
            }
        }

        // Sin preselección: el usuario debe elegir explícitamente Crítica o
        // Estándar para ver el mensaje de criterios correspondiente.
        model.TipoDesviacionCodigo = string.Empty;

        cargando = false;
    }

    private void SeleccionarTipoDesviacion(string codigo)
    {
        model.TipoDesviacionCodigo = codigo;
        mostrarModalCriterios = true;
    }

    private void CerrarModalCriterios()
    {
        mostrarModalCriterios = false;
    }

    private void AgregarCsr()
    {
        model.Csrs.Add(string.Empty);
    }

    private void QuitarCsr(int index)
    {
        if (model.Csrs.Count <= 1)
        {
            return;
        }

        if (index < 0 || index >= model.Csrs.Count)
        {
            return;
        }

        model.Csrs.RemoveAt(index);
    }

    private void ActualizarCsr(int index, string? value)
    {
        if (index < 0 || index >= model.Csrs.Count)
        {
            return;
        }

        model.Csrs[index] = value ?? string.Empty;
    }

    private void PrepararCsrsAntesDeGuardar()
    {
        var csrs = model.Csrs
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .ToList();

        model.Csrs = csrs.Count == 0
            ? new List<string> { string.Empty }
            : csrs;

        model.CSR1 = csrs.ElementAtOrDefault(0);
        model.CSR2 = csrs.ElementAtOrDefault(1);
        model.CSR3 = csrs.ElementAtOrDefault(2);
    }

    private void AgregarCliente()
    {
        clientes.Add(string.Empty);
    }

    private void QuitarCliente(int index)
    {
        if (clientes.Count <= 1)
        {
            return;
        }

        if (index < 0 || index >= clientes.Count)
        {
            return;
        }

        clientes.RemoveAt(index);
    }

    private void ActualizarCliente(int index, string? value)
    {
        if (index < 0 || index >= clientes.Count)
        {
            return;
        }

        clientes[index] = value ?? string.Empty;
    }

    private void PrepararClientesAntesDeGuardar()
    {
        var clientesNormalizados = clientes
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .ToList();

        clientes = clientesNormalizados.Count == 0
            ? new List<string> { string.Empty }
            : clientesNormalizados;

        model.Clientes = string.Join(", ", clientesNormalizados);
    }
    private void PrepararAprobadoresAntesDeGuardar()
    {
        model.AprobadoresSeleccionados = rolesAprobadores
            .Select(x => new QcDesvAprobadorSeleccionadoFormModel
            {
                RolCodigo = x.RolCodigo,
                UsuarioAprobadorId = x.UsuarioSeleccionadoId
            })
            .ToList();
    }

    private bool ValidarAprobadoresSeleccionados()
    {
        if (rolesAprobadores.Count == 0)
        {
            mensaje = "No hay aprobadores configurados. Primero configure usuarios en Administración > Aprobadores.";
            return false;
        }

        var rolesSinUsuarios = rolesAprobadores
            .Where(x => x.Usuarios.Count == 0)
            .Select(x => x.NombreEs)
            .ToList();

        if (rolesSinUsuarios.Count > 0)
        {
            mensaje = $"Hay roles sin usuarios configurados: {string.Join(", ", rolesSinUsuarios)}.";
            return false;
        }

        var rolesFaltantes = rolesAprobadores
            .Where(x => !x.UsuarioSeleccionadoId.HasValue || x.UsuarioSeleccionadoId.Value <= 0)
            .Select(x => x.NombreEs)
            .ToList();

        if (rolesFaltantes.Count > 0)
        {
            mensaje = $"Debe seleccionar aprobador para: {string.Join(", ", rolesFaltantes)}.";
            return false;
        }

        return true;
    }

    private void SeleccionarArchivos(InputFileChangeEventArgs e)
    {
        archivosSeleccionados = e.GetMultipleFiles(10).ToList();
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        mensaje = string.Empty;
        exito = false;

        PrepararClientesAntesDeGuardar();
        PrepararCsrsAntesDeGuardar();
        PrepararAprobadoresAntesDeGuardar();

        if (!ValidarAprobadoresSeleccionados())
        {
            guardando = false;
            exito = false;
            return;
        }

        if (AccionRequiereAdjunto && archivosSeleccionados.Count == 0)
        {
            mensaje = "Debe adjuntar al menos un archivo si capturó descripción de acciones.";
            guardando = false;
            return;
        }

        var usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();
        var usuario = await UsuarioActualService.ObtenerUsuarioAsync();

        model.UsuarioSolicitanteId = usuarioActualId;
        model.FechaSolicitud = DateTime.Today;

        if (usuario is not null)
        {
            model.NombreSolicitante = usuario.NombreCompleto;
        }

        var departamentoMeax = await UsuarioActualService.ObtenerDepartamentoMeaxUsuarioAutenticadoAsync();

        if (!string.IsNullOrWhiteSpace(departamentoMeax))
        {
            model.DepartamentoSolicitante = departamentoMeax;
        }

        var resultado = await SolicitudService.CrearYEnviarAsync(
            model,
            usuarioActualId);

        if (!resultado.Succeeded || resultado.Data <= 0)
        {
            mensaje = resultado.Message;
            guardando = false;
            return;
        }

        foreach (var archivo in archivosSeleccionados)
        {
            var archivoResultado = await ArchivoService.SubirArchivoSolicitudAsync(
                resultado.Data,
                archivo,
                usuarioActualId);

            if (!archivoResultado.Succeeded)
            {
                mensaje = $"La solicitud fue creada, pero un archivo no pudo subirse: {archivoResultado.Message}";
                exito = false;
                guardando = false;
                return;
            }
        }

        exito = true;
        mensaje = "Solicitud creada correctamente.";

        Navigation.NavigateTo($"solicitudes/{resultado.Data}");
    }
}