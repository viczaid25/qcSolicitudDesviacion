@page "/solicitudes/crear"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService
@inject CatalogoService CatalogoService
@inject ArchivoService ArchivoService
@inject UsuarioActualService UsuarioActualService
@inject AdminAprobadoresService AdminAprobadoresService
@inject NavigationManager Navigation

<PageTitle>@L["New deviation request"]</PageTitle>

<div class="nueva-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">@L["New Deviation"]</div>
            <div id="mo-banner-title">@L["Deviation Request"]</div>
            <div id="mo-banner-sub">
                @L["Enter the required information to start the review and approval flow."]
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-secondary-outline" href="solicitudes">@L["Back"]</a>
        </div>
    </section>

    @if (cargando)
    {
        <div class="nueva-loading">
            <div class="nueva-skeleton nueva-skeleton-form"></div>
        </div>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="@GuardarAsync">
            <div class="main-stack">
                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["General information"]</h2>
                            <p class="panel-subtitle">@L["Main request data."]</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@L["Step {0}", 1]</span>
                    </div>

                    <div class="form-grid">
                        <div class="field-with-help"
                             data-help="@L["Name of the signed-in user. This value is taken automatically from the session and cannot be changed."]">
                            <label class="mo-form-label">
                                @L["Requester Name"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <input class="mo-form-control readonly-control"
                                   value="@model.NombreSolicitante"
                                   readonly />
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Date the request is created. This value is assigned automatically and cannot be changed."]">
                            <label class="mo-form-label">
                                @L["Date"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <input type="date"
                                   class="mo-form-control readonly-control"
                                   value="@FechaSolicitudTexto"
                                   readonly />
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Requester's department. It is obtained automatically from dbo.meax_all_user using the signed-in user."]">
                            <label class="mo-form-label">
                                @L["Requesting department"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <input class="mo-form-control readonly-control"
                                   value="@model.DepartamentoSolicitante"
                                   readonly />

                            <div class="field-help">
                                @L["Department obtained from meax_all_user."]
                            </div>
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Select the business unit affected by the deviation. This identifies the main area where the temporary change applies."]">
                            <label class="mo-form-label">
                                @L["Affected Business Unit"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputSelect class="mo-form-select" @bind-Value="model.UnidadNegocioAfectada">
                                <option value="">@L["Select"]</option>

                                @foreach (var unidad in UnidadesNegocio)
                                {
                                    <option value="@unidad">@unidad</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Select the line, process or area code where the temporary deviation will be applied."]">
                            <label class="mo-form-label">
                                @L["Line Code"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputSelect class="mo-form-select" @bind-Value="model.CodigoLinea">
                                <option value="">@L["Select"]</option>

                                @foreach (var linea in CodigosLinea)
                                {
                                    <option value="@linea">@linea</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="field-with-help help-right"
                             data-help="@L["Select whether the deviation is critical or standard. If you select standard, the risk analysis will not be required."]">
                            <label class="mo-form-label">
                                @L["Deviation Type"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <div class="tipo-desviacion-options">
                                @foreach (var tipo in tiposDesviacion)
                                {
                                    <button type="button"
                                            class="tipo-desviacion-btn @(tipo.Codigo == QcDesvCodigos.TipoDesviacion.Critica ? "critica" : "estandar") @(model.TipoDesviacionCodigo == tipo.Codigo ? "selected" : "")"
                                            @onclick="() => SeleccionarTipoDesviacion(tipo.Codigo)">
                                        <span class="tipo-desviacion-nombre">@CatalogoTexto.Nombre(tipo.NombreEs, tipo.NombreEn)</span>
                                    </button>
                                }
                            </div>

                            <div class="field-help">
                                @L["If you select Standard, the risk analysis will be skipped."]
                            </div>
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Date until which the temporary deviation will be valid. It must not be earlier than the request date."]">
                            <label class="mo-form-label">
                                @L["Validity Period"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputDate class="mo-form-control" @bind-Value="model.FechaVigencia" />
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Estimated quantity of pieces affected by the deviation. This field is optional, but if entered it must be greater than zero."]">
                            <label class="mo-form-label">
                                @L["Quantity of Pieces"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputNumber class="mo-form-control" @bind-Value="model.CantidadPiezas" />

                            <div class="field-help">
                                @L["Optional field. If entered, it must be greater than 0."]
                            </div>
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Part number, model or component affected by the temporary deviation."]">
                            <label class="mo-form-label">
                                @L["Affected Part Number"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputText class="mo-form-control" @bind-Value="model.NumeroParteAfectado" />
                        </div>

                        <div class="field-with-help help-right"
                             data-help="@L["Select the 6M category related to the deviation: Method, Material, Manpower, Machine, Measurement or Other."]">
                            <label class="mo-form-label">
                                6M
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputSelect class="mo-form-select" @bind-Value="model.RequisitoProcesoCodigo">
                                <option value="">@L["Select"]</option>
                                @foreach (var requisito in requisitosProceso)
                                {
                                    <option value="@requisito.Codigo">@CatalogoTexto.Nombre(requisito.NombreEs, requisito.NombreEn)</option>
                                }
                            </InputSelect>

                            <div class="field-help">
                                @L["Select the applicable 6M category."]
                            </div>
                        </div>

                        @if (model.RequisitoProcesoCodigo == QcDesvCodigos.RequisitoProceso.Otro)
                        {
                            <div class="field-with-help"
                                 data-help="@L["Enter the 6M category when the selected option is Other."]">
                                <label class="mo-form-label">
                                    @L["Specify other"]
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputText class="mo-form-control" @bind-Value="model.RequisitoProcesoOtro" />
                            </div>
                        }
                    </div>

                    <div class="section-divider"></div>

                    <div class="client-csr-card">
                        <div class="client-csr-head">
                            <div>
                                <h3>@L["Customer and CSR"]</h3>
                                <p>@L["Enter the customer and add all the required CSRs."]</p>
                            </div>
                        </div>

                        <div class="form-grid two">
                            <div class="customer-dynamic-block field-with-help"
                                 data-help="@L["Enter the customer or customers impacted by the deviation. You can add all the customers needed."]">
                                <div class="customer-dynamic-head">
                                    <div>
                                        <label class="mo-form-label">
                                            @L["Customer(s)"]
                                            <span class="field-help-icon">?</span>
                                        </label>
                                        <p>@L["Add all required customers."]</p>
                                    </div>

                                    <button type="button"
                                            class="mo-btn mo-btn-primary mo-btn-sm"
                                            @onclick="AgregarCliente">
                                        @L["Add Customer"]
                                    </button>
                                </div>

                                <div class="customer-list">
                                    @for (var i = 0; i < clientes.Count; i++)
                                    {
                                        var index = i;

                                        <div class="customer-row">
                                            <div class="customer-number">
                                                @(index + 1)
                                            </div>

                                            <input class="mo-form-control"
                                                   value="@clientes[index]"
                                                   placeholder="@L["Customer {0}", index + 1]"
                                                   @oninput="e => ActualizarCliente(index, e.Value?.ToString())" />

                                            @if (clientes.Count > 1)
                                            {
                                                <button type="button"
                                                        class="mo-btn mo-btn-danger-outline mo-btn-sm"
                                                        @onclick="() => QuitarCliente(index)">
                                                    @L["Remove"]
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="csr-dynamic-block field-with-help help-right"
                                 data-help="@L["Enter the customer-specific requirements related to this deviation. You can add as many CSRs as needed."]">
                                <div class="csr-dynamic-head">
                                    <div>
                                        <label class="mo-form-label">
                                            CSR
                                            <span class="field-help-icon">?</span>
                                        </label>
                                        <p>@L["Add all required CSRs."]</p>
                                    </div>

                                    <button type="button"
                                            class="mo-btn mo-btn-primary mo-btn-sm"
                                            @onclick="AgregarCsr">
                                        @L["Add CSR"]
                                    </button>
                                </div>

                                <div class="csr-list">
                                    @for (var i = 0; i < model.Csrs.Count; i++)
                                    {
                                        var index = i;

                                        <div class="csr-row">
                                            <div class="csr-number">
                                                @(index + 1)
                                            </div>

                                            <input class="mo-form-control"
                                                   value="@model.Csrs[index]"
                                                   placeholder="CSR @(index + 1)"
                                                   @oninput="e => ActualizarCsr(index, e.Value?.ToString())" />

                                            @if (model.Csrs.Count > 1)
                                            {
                                                <button type="button"
                                                        class="mo-btn mo-btn-danger-outline mo-btn-sm"
                                                        @onclick="() => QuitarCsr(index)">
                                                    @L["Remove"]
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <div class="form-grid">
                        <div class="field-with-help"
                             data-help="@L["Select whether the customer needs to be informed about the requested temporary change."]">
                            <label class="mo-form-label">
                                @L["Is it necessary to inform the customer?"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputSelect class="mo-form-select" @bind-Value="model.InformarCliente">
                                <option value="false">@L["No"]</option>
                                <option value="true">@L["Yes"]</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mt-3 field-with-help"
                         data-help="@L["Explain why it is or is not necessary to inform the customer about the temporary change. If you select Yes, this field is required."]">
                        <label class="mo-form-label">
                            @L["Reason"]
                            <span class="field-help-icon">?</span>
                        </label>

                        <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.RazonInformarCliente" />
                    </div>
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Deviation Description"]</h2>
                            <p class="panel-subtitle">@L["Describe the current process and the temporary change."]</p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@L["Step {0}", 2]</span>
                    </div>

                    <div class="stack-fields">
                        <div class="field-with-help"
                             data-help="@L["Describe how the process should normally be performed according to the approved method, work instruction, procedure, standard or current specification."]">
                            <label class="mo-form-label">
                                @L["How is the process performed under normal operating conditions?"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="3"
                                           @bind-Value="model.ComoDebeRealizarseProceso" />
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Indicate the current controls applied before the deviation, for example inspections, verifications, poka-yokes, records, validations, tests or operator reviews."]">
                            <label class="mo-form-label">
                                @L["What controls are followed under normal operating conditions?"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="3"
                                           @bind-Value="model.ControlesOperacionActual" />
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Explain how the process will be performed temporarily during the deviation. Clearly describe what will change compared to the normal process and how the change will be carried out."]">
                            <label class="mo-form-label">
                                @L["What is the temporary change that will be implemented?"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="3"
                                           @bind-Value="model.ProcesoDespuesCambioTemporal" />
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Describe the additional or temporary controls that must be applied while the deviation is in effect to ensure that quality, safety, the customer or the process are not affected."]">
                            <label class="mo-form-label">
                                @L["Will additional controls be implemented during the temporary change to mitigate risks? If so, describe them."]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="3"
                                           @bind-Value="model.ControlesDuranteCambio" />
                        </div>
                    </div>
                </section>

                @if (EsCritica)
                {
                    <section class="panel-card">
                        <div class="panel-head">
                            <div>
                                <h2>@L["Risk Analysis"]</h2>
                                <p class="panel-subtitle">@L["Applies only to critical deviations."]</p>
                            </div>
                            <span class="mo-badge mo-badge-danger">@L["Critical"]</span>
                        </div>

                        <div class="mo-alert mo-alert-warning">
                            @L["Enter FMEA values between 1 and 10."]
                        </div>

                        <div class="section-divider"></div>

                        <label class="mo-form-label">
                            @L["Current operation according to FMEA"]
                        </label>

                        <div class="form-grid three">
                            <div class="field-with-help"
                                 data-help="@L["Severity value from the current FMEA. Evaluates how serious the effect of the failure would be for the customer, product, process or safety. Enter a value from 1 to 10."]">
                                <label class="mo-form-label">
                                    @L["Severity"]
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.SeveridadActual"
                                             min="1"
                                             max="10" />
                            </div>

                            <div class="field-with-help"
                                 data-help="@L["Occurrence value from the current FMEA. Indicates how likely the failure is to occur with the current process. Enter a value from 1 to 10."]">
                                <label class="mo-form-label">
                                    @L["Occurrence"]
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.OcurrenciaActual"
                                             min="1"
                                             max="10" />
                            </div>

                            <div class="field-with-help help-right"
                                 data-help="@L["Detection value from the current FMEA. Indicates how likely it is to detect the failure before it reaches the customer or the next process. Enter a value from 1 to 10."]">
                                <label class="mo-form-label">
                                    @L["Detection"]
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.DeteccionActual"
                                             min="1"
                                             max="10" />
                            </div>
                        </div>

                        <div class="section-divider"></div>

                        <label class="mo-form-label">
                            @L["Considering the change"]
                        </label>

                        <div class="form-grid two">
                            <div class="field-with-help"
                                 data-help="@L["Occurrence value considering the temporary change. Indicates how likely the failure is to occur after implementing the deviation. Enter a value from 1 to 10."]">
                                <label class="mo-form-label">
                                    @L["Occurrence with Change"]
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.OcurrenciaConCambio"
                                             min="1"
                                             max="10" />
                            </div>

                            <div class="field-with-help help-right"
                                 data-help="@L["Detection value considering the temporary change. Indicates how likely it is to detect the failure with the proposed temporary controls. Enter a value from 1 to 10."]">
                                <label class="mo-form-label">
                                    @L["Detection with Change"]
                                    <span class="field-help-icon">?</span>
                                </label>

                                <InputNumber class="mo-form-control"
                                             @bind-Value="model.DeteccionConCambio"
                                             min="1"
                                             max="10" />
                            </div>
                        </div>
                    </section>
                }

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Actions"]</h2>
                            <p class="panel-subtitle">
                                @L["Describe the actions and attach evidence when applicable."]
                            </p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@L["Step {0}", 3]</span>
                    </div>

                    <div class="stack-fields">
                        <div class="field-with-help"
                             data-help="@L["Describe the actions that will be taken to control, correct or mitigate the deviation. This field is optional, but if you enter a description you must attach at least one file as evidence or support."]">
                            <label class="mo-form-label">
                                @L["Action Description"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputTextArea class="mo-form-control"
                                           rows="4"
                                           @bind-Value="model.DescripcionAccion" />

                            <div class="field-help">
                                @L["If you enter an action description, you must attach at least one file."]
                            </div>
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Person responsible for carrying out or following up on the entered actions."]">
                            <label class="mo-form-label">
                                @L["Owner"]
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputText class="mo-form-control" @bind-Value="model.ResponsableAccion" />
                        </div>

                        <div class="field-with-help"
                             data-help="@L["Attach supporting or evidence files when you enter an action description. The maximum size per file is 20 MB."]">
                            <label class="mo-form-label">
                                @L["Attachments"]
                                @if (AccionRequiereAdjunto)
                                {
                                    <span class="required-mark">*</span>
                                }
                                <span class="field-help-icon">?</span>
                            </label>

                            <InputFile class="mo-form-control file-input" OnChange="@SeleccionarArchivos" multiple />

                            <div class="field-help">
                                @L["Maximum size per file: 20 MB."]
                            </div>

                            @if (AccionRequiereAdjunto && archivosSeleccionados.Count == 0)
                            {
                                <div class="field-warning">
                                    @L["You must attach at least one file if you entered an action description."]
                                </div>
                            }

                            @if (archivosSeleccionados.Count > 0)
                            {
                                <div class="file-list">
                                    @foreach (var archivo in archivosSeleccionados)
                                    {
                                        <span>@archivo.Name</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Approvers"]</h2>
                            <p class="panel-subtitle">
                                @L["Select the user responsible for approving each stage of the flow."]
                            </p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@L["Step {0}", 4]</span>
                    </div>

                    <div class="approver-flow-list">
                        <article class="approver-flow-card approver-flow-card-auto">
                            <div class="approver-step">1</div>

                            <div class="approver-info">
                                <h3>QMS</h3>
                                <p>QMS</p>

                                <div class="field-help">
                                    @L["Automatically assigned to system administrators; no approver selection required."]
                                </div>
                            </div>
                        </article>

                        @if (rolesAprobadores.Count == 0)
                        {
                            <div class="mo-alert mo-alert-danger">
                                @L["No approvers are configured. First configure users in Administration > Approvers."]
                            </div>
                        }
                        else
                        {
                            @foreach (var rol in rolesAprobadores.OrderBy(x => x.Orden))
                            {
                                <article class="approver-flow-card">
                                    <div class="approver-step">
                                        @rol.Orden
                                    </div>

                                    <div class="approver-info">
                                        <h3>@CatalogoTexto.Nombre(rol.NombreEs, rol.NombreEn)</h3>

                                        @if (rol.Usuarios.Count == 0)
                                        {
                                            <div class="field-warning">
                                                @L["There are no active users with this role."]
                                            </div>
                                        }
                                        else
                                        {
                                            <InputSelect TValue="int?"
                                                         class="mo-form-select"
                                                         @bind-Value="rol.UsuarioSeleccionadoId">
                                                <option value="">@L["Select approver"]</option>

                                                @foreach (var usuario in rol.Usuarios)
                                                {
                                                    <option value="@usuario.UsuarioId">
                                                        @usuario.NombreCompleto (@usuario.UserName)
                                                    </option>
                                                }
                                            </InputSelect>

                                            <div class="field-help">
                                                @L["Users available for the {0} role.", CatalogoTexto.Nombre(rol.NombreEs, rol.NombreEn)]
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </section>

                <section class="panel-card submit-panel">
                    <div class="panel-head">
                        <div>
                            <h2>@L["Submit request"]</h2>
                            <p class="panel-subtitle">
                                @L["When submitted, the request will enter the approval flow starting with QMS."]
                            </p>
                        </div>
                        <span class="mo-badge mo-badge-primary">@L["Final"]</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensaje))
                    {
                        <div class="mo-alert @(exito ? "mo-alert-success" : "mo-alert-danger")">
                            @mensaje
                        </div>
                    }

                    <div class="submit-panel-inner">
                        <a class="mo-btn mo-btn-secondary" href="solicitudes">
                            @L["Cancel"]
                        </a>

                        <button class="mo-btn mo-btn-primary" type="submit" disabled="@guardando">
                            @(guardando ? L["Saving..."] : L["Create and submit"])
                        </button>
                    </div>
                </section>
            </div>
        </EditForm>

        @if (mostrarModalCriterios)
        {
            <div class="modal-overlay" @onclick="CerrarModalCriterios">
                <div class="modal-card" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <div>
                            <h3>
                                @L["What impact does the non-compliance identified during the process review have?"]
                            </h3>
                        </div>

                        <button type="button" class="modal-close" @onclick="CerrarModalCriterios" aria-label="@L["Close"]">
                            &times;
                        </button>
                    </div>

                    <div class="modal-body">
                        @if (model.TipoDesviacionCodigo == QcDesvCodigos.TipoDesviacion.Critica)
                        {
                            <span class="mo-badge mo-badge-danger">@L["High impact"]</span>

                            <ul>
                                <li>
                                    @L["There is no evidence of adherence to compliance with a customer-committed requirement (FMEA, control plan, work instruction, process flow diagram, packaging standard)"]
                                </li>
                                <li>@L["Major risk to the final product"]</li>
                            </ul>
                        }
                        else
                        {
                            <span class="mo-badge mo-badge-primary">@L["Low impact"]</span>

                            <ul>
                                <li>
                                    @L["There is no evidence of adherence to compliance with a requirement not committed to the customer (procedures, measuring equipment)"]
                                </li>
                                <li>@L["No appreciable risk to the final product"]</li>
                            </ul>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="mo-btn mo-btn-primary" @onclick="CerrarModalCriterios">
                            @L["Understood"]
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private QcDesvSolicitudFormModel model = new();

    private static readonly string[] UnidadesNegocio =
    {
        "Alternator",
        "Starter",
        "CM",
        "Multimedia",
        "CE",
        "EPS"
    };

    private static readonly string[] CodigosLinea =
    {
        "01 SWAT",
        "02 QC Process",
        "04 Ventas",
        "06 APQP/ EC",
        "11 Alternator",
        "12 Rotor",
        "13 Coil Field",
        "14 Molding Machine",
        "15 Bracket Alternator",
        "17 Alternator GX",
        "18 Rectifier",
        "19 Regulator",
        "20 Alternador 03",
        "21 Starter",
        "22 Armature",
        "23 Yoke",
        "24 Switch",
        "25 Relay",
        "26 Brush Holder",
        "29 Starter Bracket",
        "31 VVT",
        "32 OCV",
        "33 VCT",
        "34 VCT 3G",
        "35 VCT 4G",
        "41 MM DA",
        "42 HMI",
        "43 Amplifier",
        "44 R1 - Low",
        "45 CID",
        "51 LCM - Mazda",
        "52 LCM - Honda",
        "53 LCM - Toyota",
        "54 LCM - Honda 27MY",
        "76 ECU Assy",
        "77 MCU Assy",
        "78 PCM/TCU",
        "81 SMT",
        "82 ESD"
    };

    private List<QcDesvCatTipoDesviacion> tiposDesviacion = new();
    private List<QcDesvCatRequisitoProceso> requisitosProceso = new();
    private List<IBrowserFile> archivosSeleccionados = new();
    private List<string> clientes = new() { string.Empty };
    private List<QcDesvAprobadorRolCrearVm> rolesAprobadores = new();

    private bool cargando = true;
    private bool guardando;
    private bool exito;
    private bool mostrarModalCriterios;
    private string mensaje = string.Empty;

    private string FechaSolicitudTexto => model.FechaSolicitud.ToString("yyyy-MM-dd");

    private bool EsCritica => model.TipoDesviacionCodigo == QcDesvCodigos.TipoDesviacion.Critica;

    private bool AccionRequiereAdjunto =>
        !string.IsNullOrWhiteSpace(model.DescripcionAccion);

    protected override async Task OnInitializedAsync()
    {
        tiposDesviacion = await CatalogoService.ObtenerTiposDesviacionAsync();
        requisitosProceso = await CatalogoService.ObtenerRequisitosProcesoAsync();
        rolesAprobadores = await AdminAprobadoresService.ObtenerAprobadoresParaSolicitudAsync();

        var usuario = await UsuarioActualService.ObtenerUsuarioAsync();
        var departamentoMeax = await UsuarioActualService.ObtenerDepartamentoMeaxUsuarioAutenticadoAsync();

        if (usuario is not null)
        {
            model.UsuarioSolicitanteId = usuario.Id;
            model.NombreSolicitante = usuario.NombreCompleto;
            model.DepartamentoSolicitante = departamentoMeax ?? usuario.Departamento ?? string.Empty;

            if (!string.IsNullOrWhiteSpace(usuario.UnidadNegocio) &&
                UnidadesNegocio.Contains(usuario.UnidadNegocio))
            {
                model.UnidadNegocioAfectada = usuario.UnidadNegocio;
            }
        }

        model.FechaSolicitud = DateTime.Today;
        model.FechaVigencia = DateTime.Today;

        if (model.Csrs.Count == 0)
        {
            model.Csrs.Add(string.Empty);
        }

        if (string.IsNullOrWhiteSpace(model.Clientes))
        {
            clientes = new List<string> { string.Empty };
        }
        else
        {
            clientes = model.Clientes
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            if (clientes.Count == 0)
            {
                clientes.Add(string.Empty);
            }
        }

        // Sin preselección: el usuario debe elegir explícitamente Crítica o
        // Estándar para ver el mensaje de criterios correspondiente.
        model.TipoDesviacionCodigo = string.Empty;

        cargando = false;
    }

    private void SeleccionarTipoDesviacion(string codigo)
    {
        model.TipoDesviacionCodigo = codigo;
        mostrarModalCriterios = true;
    }

    private void CerrarModalCriterios()
    {
        mostrarModalCriterios = false;
    }

    private void AgregarCsr()
    {
        model.Csrs.Add(string.Empty);
    }

    private void QuitarCsr(int index)
    {
        if (model.Csrs.Count <= 1)
        {
            return;
        }

        if (index < 0 || index >= model.Csrs.Count)
        {
            return;
        }

        model.Csrs.RemoveAt(index);
    }

    private void ActualizarCsr(int index, string? value)
    {
        if (index < 0 || index >= model.Csrs.Count)
        {
            return;
        }

        model.Csrs[index] = value ?? string.Empty;
    }

    private void PrepararCsrsAntesDeGuardar()
    {
        var csrs = model.Csrs
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .ToList();

        model.Csrs = csrs.Count == 0
            ? new List<string> { string.Empty }
            : csrs;

        model.CSR1 = csrs.ElementAtOrDefault(0);
        model.CSR2 = csrs.ElementAtOrDefault(1);
        model.CSR3 = csrs.ElementAtOrDefault(2);
    }

    private void AgregarCliente()
    {
        clientes.Add(string.Empty);
    }

    private void QuitarCliente(int index)
    {
        if (clientes.Count <= 1)
        {
            return;
        }

        if (index < 0 || index >= clientes.Count)
        {
            return;
        }

        clientes.RemoveAt(index);
    }

    private void ActualizarCliente(int index, string? value)
    {
        if (index < 0 || index >= clientes.Count)
        {
            return;
        }

        clientes[index] = value ?? string.Empty;
    }

    private void PrepararClientesAntesDeGuardar()
    {
        var clientesNormalizados = clientes
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .ToList();

        clientes = clientesNormalizados.Count == 0
            ? new List<string> { string.Empty }
            : clientesNormalizados;

        model.Clientes = string.Join(", ", clientesNormalizados);
    }
    private void PrepararAprobadoresAntesDeGuardar()
    {
        model.AprobadoresSeleccionados = rolesAprobadores
            .Select(x => new QcDesvAprobadorSeleccionadoFormModel
            {
                RolCodigo = x.RolCodigo,
                UsuarioAprobadorId = x.UsuarioSeleccionadoId
            })
            .ToList();
    }

    private bool ValidarAprobadoresSeleccionados()
    {
        if (rolesAprobadores.Count == 0)
        {
            mensaje = L["No approvers are configured. First configure users in Administration > Approvers."].Value;
            return false;
        }

        var rolesSinUsuarios = rolesAprobadores
            .Where(x => x.Usuarios.Count == 0)
            .Select(x => CatalogoTexto.Nombre(x.NombreEs, x.NombreEn))
            .ToList();

        if (rolesSinUsuarios.Count > 0)
        {
            mensaje = L["There are roles without configured users: {0}.", string.Join(", ", rolesSinUsuarios)].Value;
            return false;
        }

        var rolesFaltantes = rolesAprobadores
            .Where(x => !x.UsuarioSeleccionadoId.HasValue || x.UsuarioSeleccionadoId.Value <= 0)
            .Select(x => CatalogoTexto.Nombre(x.NombreEs, x.NombreEn))
            .ToList();

        if (rolesFaltantes.Count > 0)
        {
            mensaje = L["You must select an approver for: {0}.", string.Join(", ", rolesFaltantes)].Value;
            return false;
        }

        return true;
    }

    private void SeleccionarArchivos(InputFileChangeEventArgs e)
    {
        archivosSeleccionados = e.GetMultipleFiles(10).ToList();
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        mensaje = string.Empty;
        exito = false;

        PrepararClientesAntesDeGuardar();
        PrepararCsrsAntesDeGuardar();
        PrepararAprobadoresAntesDeGuardar();

        if (!ValidarAprobadoresSeleccionados())
        {
            guardando = false;
            exito = false;
            return;
        }

        if (AccionRequiereAdjunto && archivosSeleccionados.Count == 0)
        {
            mensaje = L["You must attach at least one file if you entered an action description."].Value;
            guardando = false;
            return;
        }

        var usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();
        var usuario = await UsuarioActualService.ObtenerUsuarioAsync();

        model.UsuarioSolicitanteId = usuarioActualId;
        model.FechaSolicitud = DateTime.Today;

        if (usuario is not null)
        {
            model.NombreSolicitante = usuario.NombreCompleto;
        }

        var departamentoMeax = await UsuarioActualService.ObtenerDepartamentoMeaxUsuarioAutenticadoAsync();

        if (!string.IsNullOrWhiteSpace(departamentoMeax))
        {
            model.DepartamentoSolicitante = departamentoMeax;
        }

        var resultado = await SolicitudService.CrearYEnviarAsync(
            model,
            usuarioActualId);

        if (!resultado.Succeeded || resultado.Data <= 0)
        {
            mensaje = resultado.Message;
            guardando = false;
            return;
        }

        foreach (var archivo in archivosSeleccionados)
        {
            var archivoResultado = await ArchivoService.SubirArchivoSolicitudAsync(
                resultado.Data,
                archivo,
                usuarioActualId);

            if (!archivoResultado.Succeeded)
            {
                mensaje = L["The request was created, but a file could not be uploaded: {0}", archivoResultado.Message].Value;
                exito = false;
                guardando = false;
                return;
            }
        }

        exito = true;
        mensaje = L["Request created successfully."].Value;

        Navigation.NavigateTo($"solicitudes/{resultado.Data}");
    }
}