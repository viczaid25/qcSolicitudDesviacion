@page "/solicitudes"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService
@inject UsuarioActualService UsuarioActualService

<PageTitle>Mis solicitudes</PageTitle>

<div class="nueva-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">qcSolicitudDesviacion</div>
            <div id="mo-banner-title">Mis solicitudes / My Requests</div>
            <div class="hero-meta">
                <span class="meta-chip">Control de proceso / Process Control</span>
                <span class="meta-chip">Aprobaciones / Approvals</span>
                <span class="meta-chip">Extensiones / Extensions</span>
            </div>
            <div id="mo-banner-sub">
                Consulta, revisa y da seguimiento a las solicitudes de desviación que has registrado.
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-primary" href="solicitudes/crear">
                Nueva solicitud / New request
            </a>
            <a class="mo-btn mo-btn-secondary-outline" href="aprobaciones/pendientes">
                Aprobaciones / Approvals
            </a>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-head">
            <div>
                <h2>Listado de mis solicitudes / My request list</h2>
                <p class="panel-subtitle">Solicitudes registradas por ti en el sistema.</p>
            </div>
            <span class="mo-badge mo-badge-primary">
                <span class="mo-badge-dot"></span>@SolicitudesFiltradas.Count() registros
            </span>
        </div>

        <div class="toolbar-actions mb-3">
            <input class="mo-form-control search-input"
                   placeholder="Buscar por ID, línea, BU, cliente o estado..."
                   @bind="filtro"
                   @bind:event="oninput" />
        </div>

        @if (cargando)
        {
            <div class="nueva-loading">
                <div class="nueva-skeleton nueva-skeleton-table"></div>
            </div>
        }
        else if (!SolicitudesFiltradas.Any())
        {
            <div class="empty-state compact">
                <div class="empty-title">Sin solicitudes / No requests</div>
                <p class="empty-text">No se encontraron solicitudes con los filtros actuales.</p>
            </div>
        }
        else
        {
            <div class="mo-table-wrap table-wrap">
                <table class="mo-table procesos-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Solicitante / Requester</th>
                            <th>Línea / Line</th>
                            <th>Unidad de negocio / BU</th>
                            <th>6M</th>
                            <th>Tipo / Type</th>
                            <th>Estado / Status</th>
                            <th>Vigencia / Validity</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in SolicitudesFiltradas)
                        {
                            <tr>
                                <td>
                                    <div class="cell-title">#@item.SolicitudId</div>
                                    <div class="cell-subtitle">@item.FechaSolicitud.ToString("yyyy-MM-dd")</div>
                                </td>
                                <td>
                                    <div class="cell-title">@item.NombreSolicitante</div>
                                    <div class="cell-subtitle">@item.DepartamentoSolicitante</div>
                                </td>
                                <td>
                                    <div class="cell-title">@item.CodigoLinea</div>
                                </td>
                                <td>
                                    <div class="cell-title">@item.UnidadNegocioAfectada</div>
                                </td>
                                <td>
                                    <div class="cell-title">@item.RequisitoProcesoEs</div>
                                </td>
                                <td>
                                    <span class="mo-badge @(item.TipoDesviacionCodigo == QcDesvCodigos.TipoDesviacion.Critica ? "mo-badge-danger" : "mo-badge-secondary")">
                                        <span class="mo-badge-dot"></span>@item.TipoDesviacionEs / @item.TipoDesviacionEn
                                    </span>
                                </td>
                                <td>
                                    <span class="mo-badge @QcDesvEstadoBadge.ClaseSolicitud(item.EstadoSolicitudCodigo)">
                                        <span class="mo-badge-dot"></span>@item.EstadoSolicitudEs
                                    </span>
                                </td>
                                <td>
                                    <div class="cell-title">@item.FechaVigencia.ToString("yyyy-MM-dd")</div>
                                    <div class="cell-subtitle">Extensiones: @item.NumeroExtensionActual</div>
                                </td>
                                <td class="text-end">
                                    <a class="mo-btn mo-btn-primary mo-btn-sm" href="solicitudes/@item.SolicitudId">
                                        Ver / View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private bool cargando = true;
    private string filtro = string.Empty;
    private List<QcDesvSolicitudResumen> solicitudes = new();

    private IEnumerable<QcDesvSolicitudResumen> SolicitudesFiltradas =>
        string.IsNullOrWhiteSpace(filtro)
            ? solicitudes
            : solicitudes.Where(x =>
                x.SolicitudId.ToString().Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                x.CodigoLinea.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                x.UnidadNegocioAfectada.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                x.Clientes.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                x.EstadoSolicitudEs.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();
        var resumen = await SolicitudService.ObtenerResumenAsync();

        solicitudes = resumen
            .Where(x => x.UsuarioSolicitanteId == usuarioActualId)
            .ToList();

        cargando = false;
    }
}