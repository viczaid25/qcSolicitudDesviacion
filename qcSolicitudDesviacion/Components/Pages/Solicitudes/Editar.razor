@page "/solicitudes/{SolicitudId:int}/editar"
@rendermode InteractiveServer

@inject SolicitudDesviacionService SolicitudService
@inject CatalogoService CatalogoService
@inject UsuarioActualService UsuarioActualService
@inject ArchivoService ArchivoService
@inject NavigationManager Navigation

<PageTitle>@L["Edit Deviation Request"]</PageTitle>

<div class="nueva-page">
    <section id="mo-banner">
        <div class="mo-banner-orb mo-banner-orb-1"></div>
        <div class="mo-banner-orb mo-banner-orb-2"></div>

        <div id="mo-banner-content">
            <div id="mo-banner-tag">@L["Edit"]</div>
            <div id="mo-banner-title">@L["Edit Deviation Request"]</div>
            <div id="mo-banner-sub">
                @L["Update the information and resubmit the request to the approval flow."]
            </div>
        </div>

        <div class="hero-actions">
            <a class="mo-btn mo-btn-secondary-outline" href="solicitudes/@SolicitudId">@L["Back"]</a>
        </div>
    </section>

    @if (cargando)
    {
        <div class="nueva-skeleton nueva-skeleton-form"></div>
    }
    else if (!string.IsNullOrWhiteSpace(mensajeInicial))
    {
        <section class="panel-card">
            <div class="mo-alert mo-alert-danger">@mensajeInicial</div>
        </section>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="@GuardarAsync">
            <div class="nueva-grid">
                <main class="main-stack">
                    <section class="panel-card">
                        <div class="panel-head">
                            <div>
                                <h2>@L["General information"]</h2>
                                <p class="panel-subtitle">@L["Update the main data."]</p>
                            </div>
                            <span class="mo-badge mo-badge-primary">@L["Request #{0}", model.SolicitudId]</span>
                        </div>

                        <div class="form-grid">
                            <div>
                                <label class="mo-form-label">@L["Requester Name"]</label>
                                <InputText class="mo-form-control" @bind-Value="model.NombreSolicitante" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Date"]</label>
                                <InputDate class="mo-form-control" @bind-Value="model.FechaSolicitud" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Requesting department"]</label>
                                <InputText class="mo-form-control" @bind-Value="model.DepartamentoSolicitante" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Affected Business Unit"]</label>
                                <InputText class="mo-form-control" @bind-Value="model.UnidadNegocioAfectada" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Line Code"]</label>
                                <InputText class="mo-form-control" @bind-Value="model.CodigoLinea" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Customer(s)"]</label>
                                <InputText class="mo-form-control" @bind-Value="model.Clientes" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Deviation Type"]</label>
                                <InputSelect class="mo-form-select" @bind-Value="model.TipoDesviacionCodigo">
                                    @foreach (var tipo in tiposDesviacion)
                                    {
                                        <option value="@tipo.Codigo">@CatalogoTexto.Nombre(tipo.NombreEs, tipo.NombreEn)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Validity Period"]</label>
                                <InputDate class="mo-form-control" @bind-Value="model.FechaVigencia" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Quantity of Pieces"]</label>
                                <InputNumber class="mo-form-control" @bind-Value="model.CantidadPiezas" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Affected Part Number"]</label>
                                <InputText class="mo-form-control" @bind-Value="model.NumeroParteAfectado" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Process Requirement"]</label>
                                <InputSelect class="mo-form-select" @bind-Value="model.RequisitoProcesoCodigo">
                                    <option value="">@L["Select"]</option>
                                    @foreach (var requisito in requisitosProceso)
                                    {
                                        <option value="@requisito.Codigo">@CatalogoTexto.Nombre(requisito.NombreEs, requisito.NombreEn)</option>
                                    }
                                </InputSelect>
                            </div>

                            @if (model.RequisitoProcesoCodigo == QcDesvCodigos.RequisitoProceso.Otro)
                            {
                                <div>
                                    <label class="mo-form-label">@L["Specify other"]</label>
                                    <InputText class="mo-form-control" @bind-Value="model.RequisitoProcesoOtro" />
                                </div>
                            }

                            <div>
                                <label class="mo-form-label">CSR 1</label>
                                <InputText class="mo-form-control" @bind-Value="model.CSR1" />
                            </div>

                            <div>
                                <label class="mo-form-label">CSR 2</label>
                                <InputText class="mo-form-control" @bind-Value="model.CSR2" />
                            </div>

                            <div>
                                <label class="mo-form-label">CSR 3</label>
                                <InputText class="mo-form-control" @bind-Value="model.CSR3" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Inform customer?"]</label>
                                <InputSelect class="mo-form-select" @bind-Value="model.InformarCliente">
                                    <option value="false">@L["No"]</option>
                                    <option value="true">@L["Yes"]</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="mo-form-label">@L["Reason"]</label>
                            <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.RazonInformarCliente" />
                        </div>
                    </section>

                    <section class="panel-card">
                        <div class="panel-head">
                            <div>
                                <h2>@L["Deviation Description"]</h2>
                            </div>
                        </div>

                        <div class="stack-fields">
                            <div>
                                <label class="mo-form-label">@L["How is the process performed under normal operating conditions?"]</label>
                                <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.ComoDebeRealizarseProceso" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["What controls are followed under normal operating conditions?"]</label>
                                <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.ControlesOperacionActual" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["What is the temporary change that will be implemented?"]</label>
                                <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.ProcesoDespuesCambioTemporal" />
                            </div>

                            <div>
                                <label class="mo-form-label">@L["Will additional controls be implemented during the temporary change to mitigate risks? If so, describe them."]</label>
                                <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.ControlesDuranteCambio" />
                            </div>
                        </div>
                    </section>

                    @if (EsCritica)
                    {
                        <section class="panel-card">
                            <div class="panel-head">
                                <div>
                                    <h2>@L["Risk Analysis"]</h2>
                                    <p class="panel-subtitle">@L["Applies only to critical deviations."]</p>
                                </div>
                                <span class="mo-badge mo-badge-danger">@L["Critical"]</span>
                            </div>

                            <div class="form-grid three">
                                <div>
                                    <label class="mo-form-label">@L["Severity"]</label>
                                    <InputNumber class="mo-form-control" @bind-Value="model.SeveridadActual" min="1" max="10" />
                                </div>

                                <div>
                                    <label class="mo-form-label">@L["Current occurrence"]</label>
                                    <InputNumber class="mo-form-control" @bind-Value="model.OcurrenciaActual" min="1" max="10" />
                                </div>

                                <div>
                                    <label class="mo-form-label">@L["Current detection"]</label>
                                    <InputNumber class="mo-form-control" @bind-Value="model.DeteccionActual" min="1" max="10" />
                                </div>
                            </div>

                            <div class="section-divider"></div>

                            <div class="form-grid two">
                                <div>
                                    <label class="mo-form-label">@L["Occurrence with Change"]</label>
                                    <InputNumber class="mo-form-control" @bind-Value="model.OcurrenciaConCambio" min="1" max="10" />
                                </div>

                                <div>
                                    <label class="mo-form-label">@L["Detection with Change"]</label>
                                    <InputNumber class="mo-form-control" @bind-Value="model.DeteccionConCambio" min="1" max="10" />
                                </div>
                            </div>
                        </section>
                    }

                    <section class="panel-card">
                        <div class="panel-head">
                            <div>
                                <h2>@L["Actions"]</h2>
                            </div>
                        </div>

                        <div class="stack-fields">
                            <div>
                                <label class="mo-form-label">@L["Action Description"]</label>
                                <InputTextArea class="mo-form-control" rows="4" @bind-Value="model.DescripcionAccion" />
                            </div>

                            <div class="form-grid two">
                                <div>
                                    <label class="mo-form-label">@L["Owner"]</label>
                                    <InputText class="mo-form-control" @bind-Value="model.ResponsableAccion" />
                                </div>

                                <div>
                                    <label class="mo-form-label">@L["Commitment Date"]</label>
                                    <InputDate class="mo-form-control" @bind-Value="model.FechaCompromisoAccion" />
                                </div>
                            </div>

                            <div>
                                <label class="mo-form-label">
                                    @L["Attachments"]
                                    @if (AccionRequiereAdjunto)
                                    {
                                        <span class="required-mark">*</span>
                                    }
                                </label>

                                @if (archivosExistentes.Count > 0)
                                {
                                    <div class="file-list">
                                        @foreach (var archivo in archivosExistentes)
                                        {
                                            <span>
                                                <a href="@archivo.RutaRelativa.TrimStart('/')" target="_blank">@archivo.NombreOriginal</a>
                                                <button type="button"
                                                        class="mo-btn mo-btn-danger-outline mo-btn-sm"
                                                        disabled="@eliminandoArchivoId.HasValue"
                                                        @onclick="() => EliminarArchivoExistenteAsync(archivo.Id)">
                                                    @L["Remove"]
                                                </button>
                                            </span>
                                        }
                                    </div>
                                }

                                <InputFile class="mo-form-control file-input" OnChange="@SeleccionarArchivos" multiple />

                                <div class="field-help">
                                    @L["Maximum size per file: 20 MB."]
                                </div>

                                @if (AccionRequiereAdjunto && !TieneAlgunArchivoAdjunto)
                                {
                                    <div class="field-warning">
                                        @L["You must attach at least one file if you entered an action description."]
                                    </div>
                                }

                                @if (archivosSeleccionados.Count > 0)
                                {
                                    <div class="file-list">
                                        @foreach (var archivo in archivosSeleccionados)
                                        {
                                            <span>@archivo.Name</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                </main>

                <aside class="side-stack">
                    <section class="panel-card sticky-card">
                        <div class="panel-head">
                            <div>
                                <h2>@L["Resubmit"]</h2>
                                <p class="panel-subtitle">@L["A new approval flow will be generated."]</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(mensaje))
                        {
                            <div class="mo-alert mo-alert-danger">@mensaje</div>
                        }

                        <button class="mo-btn mo-btn-primary w-100" type="submit" disabled="@guardando">
                            @(guardando ? L["Saving..."] : L["Save and resubmit"])
                        </button>
                    </section>
                </aside>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    private QcDesvSolicitudFormModel model = new();
    private List<QcDesvCatTipoDesviacion> tiposDesviacion = new();
    private List<QcDesvCatRequisitoProceso> requisitosProceso = new();
    private List<QcDesvArchivo> archivosExistentes = new();
    private List<IBrowserFile> archivosSeleccionados = new();

    private bool cargando = true;
    private bool guardando;
    private int? eliminandoArchivoId;
    private string mensaje = string.Empty;
    private string mensajeInicial = string.Empty;
    private int usuarioActualId;

    private bool EsCritica => model.TipoDesviacionCodigo == QcDesvCodigos.TipoDesviacion.Critica;

    private bool AccionRequiereAdjunto =>
        !string.IsNullOrWhiteSpace(model.DescripcionAccion);

    private bool TieneAlgunArchivoAdjunto =>
        archivosExistentes.Count > 0 || archivosSeleccionados.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        usuarioActualId = await UsuarioActualService.ObtenerUsuarioIdAsync();
        tiposDesviacion = await CatalogoService.ObtenerTiposDesviacionAsync();
        requisitosProceso = await CatalogoService.ObtenerRequisitosProcesoAsync();

        var resultado = await SolicitudService.ObtenerParaEditarAsync(
            SolicitudId,
            usuarioActualId);

        if (!resultado.Succeeded || resultado.Data is null)
        {
            mensajeInicial = resultado.Message;
        }
        else
        {
            model = resultado.Data;

            var detalle = await SolicitudService.ObtenerDetalleAsync(SolicitudId);

            archivosExistentes = detalle?.Archivos
                .OrderByDescending(x => x.FechaSubida)
                .ToList() ?? new();
        }

        cargando = false;
    }

    private void SeleccionarArchivos(InputFileChangeEventArgs e)
    {
        archivosSeleccionados = e.GetMultipleFiles(10).ToList();
    }

    private async Task EliminarArchivoExistenteAsync(int archivoId)
    {
        eliminandoArchivoId = archivoId;
        mensaje = string.Empty;

        var resultado = await ArchivoService.EliminarArchivoAsync(archivoId, usuarioActualId);

        if (resultado.Succeeded)
        {
            archivosExistentes.RemoveAll(x => x.Id == archivoId);
        }
        else
        {
            mensaje = resultado.Message;
        }

        eliminandoArchivoId = null;
    }

    private async Task GuardarAsync()
    {
        mensaje = string.Empty;

        if (AccionRequiereAdjunto && !TieneAlgunArchivoAdjunto)
        {
            mensaje = L["You must attach at least one file if you entered an action description."].Value;
            return;
        }

        guardando = true;

        var resultado = await SolicitudService.ActualizarYReenviarAsync(
            model,
            usuarioActualId);

        if (!resultado.Succeeded)
        {
            mensaje = resultado.Message;
            guardando = false;
            return;
        }

        foreach (var archivo in archivosSeleccionados)
        {
            var archivoResultado = await ArchivoService.SubirArchivoSolicitudAsync(
                resultado.Data,
                archivo,
                usuarioActualId);

            if (!archivoResultado.Succeeded)
            {
                mensaje = L["The request was updated, but a file could not be uploaded: {0}", archivoResultado.Message].Value;
                guardando = false;
                return;
            }
        }

        Navigation.NavigateTo($"solicitudes/{resultado.Data}");
    }
}